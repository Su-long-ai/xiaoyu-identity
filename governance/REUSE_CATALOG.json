  "rules": [
    {
      "id": "no_handwritten_lexical_postings",
      "family_regex": "(?i)(retrieval|search|index)",
      "hypothesis_regex": "(?i)(posting|inverted.?index|倒排|lexical index|n-gram evidence index)",
      "required_components": [
        "sqlite_fts5"
      ],
      "allowed_modes": [
        "reuse",
        "extend",
        "falsification"
      ],
      "message": "Lexical postings must reuse SQLite FTS5; a handwritten posting engine is research-only falsification, not the production direction."
    },
    {
      "id": "archive_zip_legacy_only",
      "family_regex": "(?i)^archive\\.(zip|json|dual|parser|import|export)",
      "required_components": [
        "sqlite_backup"
      ],
      "allowed_modes": [
        "legacy_compat",
        "falsification"
      ],
      "message": "Future portable identity is single authoritative SQLite snapshot. ZIP/JSON work is legacy migration/regression only."
    },
    {
      "id": "provenance_must_reuse_generic_mechanics",
      "family_regex": "(?i)provenance",
      "required_any_components": [
        "cognee_provenance",
        "graphiti_temporal"
      ],
      "allowed_modes": [
        "reuse",
        "extend",
        "custom_policy",
        "falsification"
      ],
      "message": "Do not create another generic provenance platform; custom work must be XiaoYu-specific authority/source/quarantine policy."
    },
    {
      "id": "no_custom_vector_graph_ann",
      "hypothesis_regex": "(?i)(build|implement|create|自研|新建).{0,24}(vector database|vector store|ANN|graph database|向量数据库|向量库|图数据库)",
      "allowed_modes": [
        "falsification"
      ],
      "message": "Custom graph/vector/ANN infrastructure is frozen; reuse an existing backend unless a falsification experiment proves it insufficient."
    },
    {
      "id": "external_framework_set_frozen",
      "family_regex": "(?i)^oss\\.audit\\.identity$",
      "required_any_components": [
        "mem0_oss",
        "hindsight",
        "cognee",
        "graphiti",
        "omnimemeval"
      ],
      "allowed_modes": [
        "reuse",
        "falsification"
      ],
      "message": "Broad framework collection is frozen to Mem0/Hindsight/Cognee/Graphiti + OmniMemEval."
    },
    {
      "id": "ci_supply_chain_scope_frozen",
      "family_regex": "(?i)^ci\\.",
      "required_any_components": [
        "stdlib_hashlib",
        "xiaoyu_existing_core"
      ],
      "allowed_modes": [
        "reuse",
        "extend",
        "falsification"
      ],
      "message": "CI work may maintain the minimal gate trust root but must not grow into a custom supply-chain platform."
    }
  ],
  "universal_requirements": {
    "research_engineer_plan_required": true,
    "known_component_ids_only": true,
    "min_gap_chars": 40,
    "max_components": 8,
    "no_new_infrastructure_must_be_true": true,
    "allowed_modes": [
      "reuse",
      "extend",
      "custom_policy",
      "legacy_compat",
      "falsification",
      "grandfathered_recovery"
    ]
  },
