{
  "schema_version": 1,
  "policy_id": "XIAOYU_PLUGIN_AUTOSTART_ADMISSION_V1",
  "scope": "runtime_auto_start_only",
  "security_model": {
    "admission_only_not_sandbox": true,
    "capability_grants_are_not_malicious_plugin_isolation": true,
    "explicit_manual_owner_start_out_of_scope": true,
    "no_private_permission_store": true,
    "no_private_plugin_host": true
  },
  "admitted_autostart_plugins": {
    "proactive_controller": {
      "provenance": "neko_native",
      "source": "plugin/plugins/proactive_controller",
      "rationale": "N.E.K.O native proactive execution authority"
    },
    "web_search": {
      "provenance": "neko_native",
      "source": "plugin/plugins/web_search",
      "rationale": "N.E.K.O native bundled search plugin"
    },
    "qq_auto_reply": {
      "provenance": "pinned_external",
      "source": "plugin/plugins/qq_auto_reply",
      "lock": "QQ_PLUGIN_UPSTREAM.lock.json",
      "tested_commit": "54acf36bf978edad4757e5fffc743c5618360700",
      "rationale": "Pinned external QQ surface reused through N.E.K.O plugin lifecycle"
    },
    "xiaoyu_interaction_policy": {
      "provenance": "private_reviewed",
      "source": "plugins/xiaoyu_interaction_policy",
      "reuse_review_id": "plugin:xiaoyu_interaction_policy",
      "rationale": "Only admitted private runtime policy adapter"
    }
  },
  "state_rules": {
    "any_enabled_autostart_plugin_must_be_admitted": true,
    "autostart_pending_is_not_started": true,
    "unknown_or_unreviewed_autostart_fails_closed": true,
    "disabled_or_manual_only_plugin_does_not_require_autostart_admission": true
  }
}
