+    def _remember_id(self, message: dict[str, Any]) -> None:
+        """记住处理过的 message_id（去重名单）。"""
+        mid = str(message.get("message_id") or "").strip()
+        if not mid:
+            return
+        self._recent_ids[mid] = time.time()
+        self._recent_ids.move_to_end(mid)
+        while len(self._recent_ids) > self.MAX_RECENT_IDS:
+            self._recent_ids.popitem(last=False)
+
+    def claim_inbound_message(self, message: dict[str, Any]) -> bool:
+        """按稳定 message_id 抢占一次入站事件；重复事件直接拒绝。
+
+        实时 receive loop 是单协程串行取消息，这个同步 claim 必须发生在
+        create_task 之前：两个相同 OneBot event 即使随后并发处理，也只有
+        第一条能进入 handler。断线补消息也复用同一名单，避免 live/catch-up
+        在重连边界各处理一次。没有稳定 id 的事件保持旧行为，不猜等价关系。
+        """
+        if str(message.get("post_type") or "message") != "message":
+            return True
+        mid = str(message.get("message_id") or "").strip()
+        if not mid:
+            return True
+        if mid in self._recent_ids:
+            self._diag["skipped_inbound_dup"] += 1
+            return False
+        self._remember_id(message)
+        self._dirty = True
+        return True
+
