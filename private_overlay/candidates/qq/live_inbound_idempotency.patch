+@_sync
+async def test_cursor_survives_a_restart(tmp_path: Path) -> None:
+    """游标要落盘：插件重载后不该从零开始重新对齐。"""
+    plugin, _c, _d = _plugin(tmp_path)
+    svc = QQMessageCatchupService(plugin)
+    svc.note_message(_msg(42, mid="keep"))
+    await svc._flush(force=True)
+
+    fresh = QQMessageCatchupService(plugin)
+    await fresh._load()
+
+    assert fresh._cursors["group:500"]["seq"] == 42
+    assert "keep" in fresh._recent_ids
+
+
+@_sync
+async def test_live_claim_rejects_a_persisted_replay_after_restart(tmp_path: Path) -> None:
+    plugin, _c, _d = _plugin(tmp_path)
+    svc = QQMessageCatchupService(plugin)
+    assert svc.claim_inbound_message(_msg(42, mid="once")) is True
+    await svc._flush(force=True)
+
+    fresh = QQMessageCatchupService(plugin)
+    await fresh._load()
+
+    assert fresh.claim_inbound_message(_msg(42, mid="once")) is False
+    assert fresh._diag["skipped_inbound_dup"] == 1
+
+
+def test_live_claim_is_atomic_for_stable_ids_and_passthrough_without_id(tmp_path: Path) -> None:
+    plugin, _c, _d = _plugin(tmp_path)
+    svc = QQMessageCatchupService(plugin)
+    message = _msg(5, mid="stable")
+    assert svc.claim_inbound_message(message) is True
+    assert svc.claim_inbound_message(dict(message)) is False
+
+    no_id = _msg(6, mid="")
+    no_id.pop("message_id", None)
+    assert svc.claim_inbound_message(no_id) is True
+    assert svc.claim_inbound_message(dict(no_id)) is True
+
+
+def test_live_receive_claims_before_handler_task_and_after_persisted_state_load() -> None:
+    root = Path(__file__).resolve().parents[1]
+    dispatcher = (root / "message_dispatcher.py").read_text(encoding="utf-8")
+    runtime = (root / "runtime_ops_service.py").read_text(encoding="utf-8")
+
+    claim_at = dispatcher.index("catchup.claim_inbound_message(message)")
+    task_at = dispatcher.index("create_task(self.plugin._run_message_handler(message))")
+    assert claim_at < task_at
+
+    load_at = runtime.index("await catchup.start()")
+    receive_loop_at = runtime.index(
+        "create_task(self.plugin._process_messages())"
+    )
+    assert load_at < receive_loop_at
+
+
