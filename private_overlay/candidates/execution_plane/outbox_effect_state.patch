+    assert retry_delay(1025) == 300.0
+    assert retry_delay(10**6) == 300.0
+
+
+async def test_effect_handoff_is_not_mistaken_for_delivery(ledger):
+    item_id = await ledger.outbox_add(None, "task_result", {"summary": "done"})
+
+    async def send(_item: Any):
+        return DeliveryHandoff("attempt-a")
+
+    sender = OutboxSender(ledger, send, clock=time.time)
+    delivered = await sender.flush()
+
+    assert delivered == 0
+    assert await ledger.outbox_delivery_state(item_id) == "handoff"
+    assert await ledger.outbox_pending() == []
+    assert await ledger.outbox_next_due() is None
+
+
+async def test_restart_retries_preclaim_handoff_but_freezes_claimed_effect(tmp_path):
+    path = tmp_path / "effect-ledger.db"
+    first = Ledger(path)
+    safe = await first.outbox_add(None, "task_result", {"summary": "safe"})
+    risky = await first.outbox_add(None, "task_result", {"summary": "risky"})
+    await first.outbox_mark_handoff(safe, "safe-attempt")
+    await first.outbox_mark_handoff(risky, "risky-attempt")
+    assert await first.outbox_claim_delivery(risky, "risky-attempt") == "claimed"
+    await first.close()
+
+    second = Ledger(path)
+    try:
+        await second.open()
+        assert await second.outbox_delivery_state(safe) == "pending"
+        assert await second.outbox_delivery_state(risky) == "uncertain"
+        assert [item.id for item in await second.outbox_pending()] == [safe]
+    finally:
+        await second.close()
 
 
