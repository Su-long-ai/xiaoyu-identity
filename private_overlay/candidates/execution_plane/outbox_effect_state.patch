+    async def outbox_mark_handoff(self, item_id: int, attempt_id: str) -> bool:
+        """Lease a row before the event is put on the existing IPC transport."""
+        handoff = _OUTBOX_DELIVERY_HANDOFF + str(attempt_id)
+        def work(conn: sqlite3.Connection) -> bool:
+            row = conn.execute(
+                "SELECT sent_at, last_error, next_attempt_at FROM outbox WHERE id = ?",
+                (item_id,),
+            ).fetchone()
+            if row is None or row["sent_at"] is not None:
+                return False
+            state = str(row["last_error"] or "")
+            now = self._clock()
+            if state == handoff:
+                return True
+            if state.startswith(_OUTBOX_DELIVERY_HANDOFF):
+                if float(row["next_attempt_at"] or 0.0) > now:
+                    return False
+            elif state.startswith((_OUTBOX_DELIVERY_CLAIMED, _OUTBOX_DELIVERY_UNCERTAIN)):
+                return False
+            conn.execute(
+                "UPDATE outbox SET last_error = ?, next_attempt_at = ? WHERE id = ? AND sent_at IS NULL",
+                (handoff, now + _OUTBOX_HANDOFF_LEASE_SECONDS, item_id),
+            )
+            return True
+        return await self.run(work)
+
+    async def outbox_fail_handoff(
+        self,
+        item_id: int,
+        attempt_id: str,
+        error: str,
+        next_attempt_at: float,
+    ) -> bool:
+        """Release only the exact pre-effect handoff after proven transport rejection."""
+        handoff = _OUTBOX_DELIVERY_HANDOFF + str(attempt_id)
+        def work(conn: sqlite3.Connection) -> bool:
+            cursor = conn.execute(
+                "UPDATE outbox SET attempts = attempts + 1, last_error = ?, next_attempt_at = ? "
+                "WHERE id = ? AND sent_at IS NULL AND last_error = ?",
+                (error, next_attempt_at, item_id, handoff),
+            )
+            return int(cursor.rowcount or 0) == 1
+        return await self.run(work)
+
+    async def outbox_claim_delivery(self, item_id: int, attempt_id: str, claim_id: str) -> str:
+        """Authorize one exact main-process claim to cross the effect boundary."""
+        handoff = _OUTBOX_DELIVERY_HANDOFF + str(attempt_id)
+        claimed_prefix = _OUTBOX_DELIVERY_CLAIMED + str(attempt_id) + ":"
+        claimed = claimed_prefix + str(claim_id)
+        def work(conn: sqlite3.Connection) -> str:
+            row = conn.execute(
+                "SELECT sent_at, last_error, next_attempt_at FROM outbox WHERE id = ?",
+                (item_id,),
+            ).fetchone()
+            if row is None:
+                return "gone"
+            if row["sent_at"] is not None:
+                return "sent"
+            state = str(row["last_error"] or "")
+            if state == handoff:
+                if float(row["next_attempt_at"] or 0.0) <= self._clock():
+                    return "expired"
+                conn.execute(
+                    "UPDATE outbox SET last_error = ? WHERE id = ? AND sent_at IS NULL AND last_error = ?",
+                    (claimed, item_id, handoff),
+                )
+                return "claimed"
+            if state == claimed:
+                return "claimed"
+            if state.startswith(claimed_prefix):
+                return "already_claimed"
+            if state.startswith(_OUTBOX_DELIVERY_UNCERTAIN):
+                return "uncertain"
+            return "not_ready"
+        return await self.run(work)
+
+    async def outbox_commit_delivery(self, item_id: int, attempt_id: str, claim_id: str) -> str:
+        """Persist a positive effect receipt for the exact durable main claim."""
+        suffix = str(attempt_id) + ":" + str(claim_id)
+        valid = {_OUTBOX_DELIVERY_CLAIMED + suffix, _OUTBOX_DELIVERY_UNCERTAIN + suffix}
+        def work(conn: sqlite3.Connection) -> str:
+            row = conn.execute("SELECT sent_at, last_error FROM outbox WHERE id = ?", (item_id,)).fetchone()
+            if row is None:
+                return "gone"
+            if row["sent_at"] is not None:
+                return "sent"
+            if str(row["last_error"] or "") not in valid:
+                return "not_ready"
+            conn.execute(
+                "UPDATE outbox SET sent_at = ?, attempts = attempts + 1, last_error = NULL "
+                "WHERE id = ? AND sent_at IS NULL",
+                (self._clock(), item_id),
+            )
+            return "committed"
+        return await self.run(work)
+
+    async def outbox_release_delivery(self, item_id: int, attempt_id: str, claim_id: str) -> str:
+        """Return an exact claim to retryable state only after proven no-effect."""
+        claimed = _OUTBOX_DELIVERY_CLAIMED + str(attempt_id) + ":" + str(claim_id)
+        def work(conn: sqlite3.Connection) -> str:
+            row = conn.execute("SELECT sent_at, last_error FROM outbox WHERE id = ?", (item_id,)).fetchone()
+            if row is None:
+                return "gone"
+            if row["sent_at"] is not None:
+                return "sent"
+            state = str(row["last_error"] or "")
+            if state.startswith(_OUTBOX_DELIVERY_UNCERTAIN):
+                return "uncertain"
+            if state != claimed:
+                return "not_ready"
+            conn.execute(
+                "UPDATE outbox SET last_error = 'delivery released before effect', next_attempt_at = ? "
+                "WHERE id = ? AND sent_at IS NULL AND last_error = ?",
+                (self._clock(), item_id, claimed),
+            )
+            return "released"
+        return await self.run(work)
+
+    async def outbox_mark_main_restart_uncertain(self) -> int:
+        """Freeze in-flight main claims after a proven main-process epoch change."""
+        def work(conn: sqlite3.Connection) -> int:
+            cursor = conn.execute(
+                "UPDATE outbox SET last_error = REPLACE(last_error, ?, ?) "
+                "WHERE sent_at IS NULL AND last_error LIKE ?",
+                (_OUTBOX_DELIVERY_CLAIMED, _OUTBOX_DELIVERY_UNCERTAIN, _OUTBOX_DELIVERY_CLAIMED + "%"),
+            )
+            return max(0, int(cursor.rowcount or 0))
+        return await self.run(work)
+
+    async def outbox_mark_sent(self, item_id: int) -> None:
+        await self.run(
+            lambda conn: conn.execute(
+                "UPDATE outbox SET sent_at = ?, attempts = attempts + 1, last_error = NULL "
+                "WHERE id = ? AND sent_at IS NULL",
+                (self._clock(), item_id),
+            )
+            and None
+        )
+
+    async def outbox_delivery_state(self, item_id: int) -> str:
+        """Return durable delivery state without making an effect decision."""
+        def work(conn: sqlite3.Connection) -> str:
+            row = conn.execute("SELECT sent_at, last_error FROM outbox WHERE id = ?", (item_id,)).fetchone()
+            if row is None:
+                return "gone"
+            if row["sent_at"] is not None:
+                return "sent"
+            state = str(row["last_error"] or "")
+            if state.startswith(_OUTBOX_DELIVERY_HANDOFF):
+                return "handoff"
+            if state.startswith(_OUTBOX_DELIVERY_CLAIMED):
+                return "claimed"
+            if state.startswith(_OUTBOX_DELIVERY_UNCERTAIN):
+                return "uncertain"
+            return "pending"
+        return await self.run(work)
 
