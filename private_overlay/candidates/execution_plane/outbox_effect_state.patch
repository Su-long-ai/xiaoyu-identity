+    async def outbox_mark_handoff(self, item_id: int, attempt_id: str) -> bool:
+        """Persist transport intent before the event is allowed onto IPC."""
+        handoff = _OUTBOX_DELIVERY_HANDOFF + str(attempt_id)
+
+        def work(conn: sqlite3.Connection) -> bool:
+            row = conn.execute(
+                "SELECT sent_at, last_error FROM outbox WHERE id = ?",
+                (item_id,),
+            ).fetchone()
+            if row is None or row["sent_at"] is not None:
+                return False
+            state = str(row["last_error"] or "")
+            if state == handoff:
+                return True
+            if state.startswith(
+                (_OUTBOX_DELIVERY_HANDOFF, _OUTBOX_DELIVERY_CLAIMED, _OUTBOX_DELIVERY_UNCERTAIN)
+            ):
+                return False
+            conn.execute(
+                "UPDATE outbox SET last_error = ?, next_attempt_at = ? "
+                "WHERE id = ? AND sent_at IS NULL",
+                (handoff, self._clock(), item_id),
+            )
+            return True
+
+        return await self.run(work)
+
+    async def outbox_claim_delivery(self, item_id: int, attempt_id: str, claim_id: str) -> str:
+        """Grant one main-process claim token permission to cross the effect boundary."""
+        handoff = _OUTBOX_DELIVERY_HANDOFF + str(attempt_id)
+        claimed = _OUTBOX_DELIVERY_CLAIMED + str(attempt_id) + ":" + str(claim_id)
+
+        def work(conn: sqlite3.Connection) -> str:
+            row = conn.execute(
+                "SELECT sent_at, last_error FROM outbox WHERE id = ?",
+                (item_id,),
+            ).fetchone()
+            if row is None:
+                return "gone"
+            if row["sent_at"] is not None:
+                return "sent"
+            state = str(row["last_error"] or "")
+            if state == handoff:
+                conn.execute(
+                    "UPDATE outbox SET last_error = ? "
+                    "WHERE id = ? AND sent_at IS NULL AND last_error = ?",
+                    (claimed, item_id, handoff),
+                )
+                return "claimed"
+            if state == claimed:
+                return "claimed"
+            if state.startswith(_OUTBOX_DELIVERY_CLAIMED + str(attempt_id) + ":"):
+                return "already_claimed"
+            if state.startswith(_OUTBOX_DELIVERY_UNCERTAIN):
+                return "uncertain"
+            return "not_ready"
+
+        return await self.run(work)
+
+    async def outbox_commit_delivery(self, item_id: int, attempt_id: str, claim_id: str) -> str:
+        """Persist a positive effect receipt for the exact durable main-process claim."""
+        suffix = str(attempt_id) + ":" + str(claim_id)
+        claimed = _OUTBOX_DELIVERY_CLAIMED + suffix
+        uncertain = _OUTBOX_DELIVERY_UNCERTAIN + suffix
+
+        def work(conn: sqlite3.Connection) -> str:
+            row = conn.execute(
+                "SELECT sent_at, last_error FROM outbox WHERE id = ?",
+                (item_id,),
+            ).fetchone()
+            if row is None:
+                return "gone"
+            if row["sent_at"] is not None:
+                return "sent"
+            state = str(row["last_error"] or "")
+            if state not in (claimed, uncertain):
+                return "not_ready"
+            conn.execute(
+                "UPDATE outbox SET sent_at = ?, attempts = attempts + 1, "
+                "last_error = NULL WHERE id = ? AND sent_at IS NULL",
+                (self._clock(), item_id),
+            )
+            return "committed"
+
+        return await self.run(work)
+
+    async def outbox_mark_sent(self, item_id: int) -> None:
+        await self.run(
+            lambda conn: conn.execute(
+                "UPDATE outbox SET sent_at = ?, attempts = attempts + 1, last_error = NULL "
+                "WHERE id = ? AND sent_at IS NULL",
+                (self._clock(), item_id),
+            )
+            and None
+        )
+
+    async def outbox_delivery_state(self, item_id: int) -> str:
+        """Return the durable delivery state without making an effect decision."""
+        def work(conn: sqlite3.Connection) -> str:
+            row = conn.execute(
+                "SELECT sent_at, last_error FROM outbox WHERE id = ?",
+                (item_id,),
+            ).fetchone()
+            if row is None:
+                return "gone"
+            if row["sent_at"] is not None:
+                return "sent"
+            state = str(row["last_error"] or "")
+            if state.startswith(_OUTBOX_DELIVERY_HANDOFF):
+                return "handoff"
+            if state.startswith(_OUTBOX_DELIVERY_CLAIMED):
+                return "claimed"
+            if state.startswith(_OUTBOX_DELIVERY_UNCERTAIN):
+                return "uncertain"
+            return "pending"
+
+        return await self.run(work)
 
