     """
 
 
+def _queue_text_payload(text: str) -> dict[str, Any]:
+    """Serialize only the provenance N.E.K.O already attaches to queued text."""
+    payload: dict[str, Any] = {"text": str(text), "provenance": "user"}
+    if isinstance(text, _Handed):
+        payload["provenance"] = "handed"
+        payload["wakes"] = list(text.wakes)
+    elif isinstance(text, _Unsaid):
+        payload["provenance"] = "unsaid"
+        payload["recipient"] = text.recipient
+        payload["retried"] = bool(text.retried)
+    elif isinstance(text, _Found):
+        payload["provenance"] = "found"
+    return payload
+
+
+def _queue_text_from_payload(payload: Any) -> str | None:
+    """Rebuild one queued text without flattening its trust provenance."""
+    if not isinstance(payload, dict) or not isinstance(payload.get("text"), str):
+        return None
+    text = payload["text"]
+    provenance = payload.get("provenance", "user")
+    if provenance == "user":
+        return text
+    if provenance == "found":
+        return _Found(text)
+    if provenance == "handed":
+        wakes = payload.get("wakes")
+        if (
+            not isinstance(wakes, list)
+            or any(isinstance(item, bool) or not isinstance(item, int) or item <= 0 for item in wakes)
+        ):
+            return None
+        return _Handed(text, wakes)
+    if provenance == "unsaid":
+        recipient = payload.get("recipient")
+        if not isinstance(recipient, str) or not recipient:
+            return None
+        restored = _Unsaid(text, recipient)
+        restored.retried = bool(payload.get("retried", False))
+        return restored
+    return None
+
