+    async def _restart_queue_resume(self, commission_id: str) -> str | None:
+        """Return the latest durable resume text for a queued re-take."""
+        after = 0
+        found: str | None = None
+        invalid = False
+        while True:
+            page = await self._ledger.events(commission_id, after=after)
+            for event in page:
+                if event.type != "restart_queue_resume":
+                    continue
+                restored = _queue_text_from_payload(event.payload.get("resume"))
+                invalid = restored is None
+                found = restored
+            if len(page) < 500:
+                if invalid:
+                    raise ValueError("queued continuation provenance is not recoverable")
+                return found
+            after = page[-1].seq
+
+    def recover_restart_queue(self) -> None:
+        """Reconstruct durable task-agent queue entries from an earlier host."""
+        if not self._closed:
+            self._spawn(self._recover_restart_queue())
+
+    async def _recover_restart_queue(self) -> None:
+        recovered = 0
+        for commission in await self._ledger.select(statuses={"queued"}, oldest_first=True):
+            if self._closed:
+                return
+            if commission.route != "task_agent" or commission.id in self._queue or commission.id in self._sessions:
+                continue
+
+            # Re-read after the scan point. A concurrent cancel/stop is
+            # terminal and wins over restart recovery.
+            current = await self._ledger.get(commission.id)
+            if current is None or current.route != "task_agent" or current.status != "queued":
+                continue
+
+            try:
+                resume = await self._restart_queue_resume(commission.id)
+            except ValueError as exc:
+                await self._ledger.transition(
+                    commission.id,
+                    "blocked",
+                    reason=f"restart queue recovery blocked: {exc}",
+                )
+                continue
+
+            # A re-take queued by this seam must have its durable continuation.
+            # Initial queued work has no such reason and starts from the native
+            # opening message instead. An old/pre-candidate re-take fails closed.
+            if current.status_reason == "taken up again; waiting for a place" and resume is None:
+                await self._ledger.transition(
+                    commission.id,
+                    "blocked",
+                    reason="restart queue recovery blocked: durable continuation is missing",
+                )
+                continue
+
+            # The session id is native authority. Never mint a replacement
+            # during recovery: that could change transcript/capability scope.
+            if not current.session_id:
+                await self._ledger.transition(
+                    commission.id,
+                    "blocked",
+                    reason="restart queue recovery blocked: durable session identity is missing",
+                )
+                continue
+            if not await self._know_session(commission.id):
+                await self._ledger.transition(
+                    commission.id,
+                    "blocked",
+                    reason="restart queue recovery blocked: native session is unavailable",
+                )
+                continue
+
+            # One last terminality check after session lookup. Nothing is
+            # enqueued if cancellation won in the meantime.
+            current = await self._ledger.get(commission.id)
+            if current is None or current.status != "queued":
+                self._session_of.pop(commission.id, None)
+                continue
+            if resume is not None:
+                self._resume[commission.id] = resume
+            self._queue.append(commission.id)
+            recovered += 1
+
+        if recovered and not self._closed and len(self._sessions) < self.limit:
+            self._spawn(self._start_next())
+
