+async def publish_nekoclaw_delivery_barrier(
+    action: str,
+    delivery_id: int,
+    attempt_id: str,
+    claim_id: str,
+    *,
+    lanlan_name: Optional[str] = None,
+    ack_timeout_s: float = 0.8,
+    retries: int = 1,
+) -> str:
+    """Persist claim/commit/release through the native NekoClaw ledger."""
+    if action not in {"claim", "commit", "release"}:
+        return ""
+    if isinstance(delivery_id, bool) or int(delivery_id) <= 0:
+        return ""
+    attempt = str(attempt_id or "").strip()
+    claim = str(claim_id or "").strip()
+    if not attempt or not claim:
+        return ""
+    event: Dict[str, Any] = {
+        "event_type": "nekoclaw_delivery_barrier",
+        "event_id": uuid.uuid4().hex,
+        "main_epoch": str(getattr(_main_bridge_ref, "instance_id", "") or ""),
+        "action": action,
+        "delivery_id": int(delivery_id),
+        "delivery_attempt_id": attempt,
+        "delivery_claim_id": claim,
+    }
+    if lanlan_name:
+        event["lanlan_name"] = lanlan_name
+    result = await _publish_analyze_request_with_ack(
+        event, ack_timeout_s=ack_timeout_s, retries=retries, label=f"nekoclaw_delivery_{action}"
+    )
+    return str(result or "")
 
 
