+async def _publish_analyze_request_with_ack(
+    event: Dict[str, Any],
+    *,
+    ack_timeout_s: float,
+    retries: int,
+    label: str,
+    bridge_override: Optional[MainServerAgentBridge] = None,
+) -> Any:
+    """Reuse the existing reliable main→agent analyze channel."""
+    event = dict(event)
+    event_id = str(event.get("event_id") or uuid.uuid4().hex)
+    event["event_id"] = event_id
+    sent_at = time.perf_counter()
+    for attempt in range(max(retries, 0) + 1):
+        loop = asyncio.get_running_loop()
+        waiter: asyncio.Future = loop.create_future()
+        with _ack_waiters_lock:
+            _ack_waiters[event_id] = waiter
+        bridge = bridge_override or _main_bridge_ref
+        if bridge is None or bridge.owner_loop is None:
+            with _ack_waiters_lock:
+                _ack_waiters.pop(event_id, None)
+            return None
+        if threading.get_ident() == bridge.owner_thread_id:
+            sent = await bridge.publish_analyze_request(event)
+        else:
+            try:
+                if bridge.owner_loop.is_closed():
+                    sent = False
+                else:
+                    coro = bridge.publish_analyze_request(event)
+                    try:
+                        cf = asyncio.run_coroutine_threadsafe(coro, bridge.owner_loop)
+                        sent = await asyncio.wrap_future(cf)
+                    except Exception as exc:
+                        coro.close()
+                        logger.debug("[EventBus] %s threadsafe publish failed: %s", label, exc)
+                        sent = False
+            except Exception as exc:
+                logger.debug("[EventBus] %s threadsafe publish failed: %s", label, exc)
+                sent = False
+        if not sent:
+            with _ack_waiters_lock:
+                _ack_waiters.pop(event_id, None)
+            if attempt < max(retries, 0):
+                await asyncio.sleep(min(0.05 * (attempt + 1), 0.2))
+            continue
+        try:
+            result = await asyncio.wait_for(waiter, timeout=ack_timeout_s)
+            logger.debug("[EventBus] %s acked: event_id=%s latency_ms=%.1f", label, event_id, (time.perf_counter() - sent_at) * 1000.0)
+            return result
+        except asyncio.TimeoutError:
+            with _ack_waiters_lock:
+                _ack_waiters.pop(event_id, None)
+            logger.info("[EventBus] %s ack timeout (attempt %d): event_id=%s", label, attempt + 1, event_id)
+    return None
+
