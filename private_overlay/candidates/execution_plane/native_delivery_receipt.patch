+def _resolve_ack(event_id: str, result: Any) -> None:
+    """Resolve one acknowledged main→agent request on its waiter's loop."""
+    if not event_id:
+        return
+    waiter = None
+    with _ack_waiters_lock:
+        waiter = _ack_waiters.pop(event_id, None)
+    if waiter is None or waiter.done():
+        return
+    loop = waiter.get_loop()
+
+    def _resolve() -> None:
+        if not waiter.done():
+            waiter.set_result(result)
+
+    loop.call_soon_threadsafe(_resolve)
+
+
+def notify_turn_check_ack(event_id: str) -> None:
+    _resolve_ack(event_id, True)
+
+
+def notify_nekoclaw_delivery_barrier_ack(event_id: str, result: str) -> None:
+    _resolve_ack(event_id, str(result or ""))
+
+
+def notify_nekoclaw_main_epoch_ack(event_id: str, result: str) -> None:
+    _resolve_ack(event_id, str(result or ""))
 
 
