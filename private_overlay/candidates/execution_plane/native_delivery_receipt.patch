+async def _announce_nekoclaw_main_epoch(bridge: MainServerAgentBridge) -> None:
+    """Reliably announce one main-process lifetime over the native analyze lane."""
+    try:
+        result = await _publish_analyze_request_with_ack(
+            {
+                "event_type": "nekoclaw_main_epoch",
+                "main_epoch": bridge.instance_id,
+            },
+            ack_timeout_s=0.35,
+            retries=8,
+            label="nekoclaw_main_epoch",
+            bridge_override=bridge,
+        )
+        if not result:
+            logger.warning("[EventBus] NekoClaw main epoch was not acknowledged")
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        logger.warning(
+            "[EventBus] NekoClaw main epoch announcement failed: %s",
+            type(exc).__name__,
+        )
+
