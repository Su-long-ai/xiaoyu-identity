+async def _send_effect_report(item: Any, event: Dict[str, Any]) -> Any:
+    """Persist handoff before the existing agent→main transport sees the event."""
+    from nekoclaw.host.outbox import DeliveryHandoff
+    host = peek_host()
+    if host is None:
+        return False
+    attempt_id = uuid.uuid4().hex
+    if not await host.ledger.outbox_mark_handoff(item.id, attempt_id):
+        return False
+    payload = dict(event)
+    payload["delivery_id"] = int(item.id)
+    payload["delivery_attempt_id"] = attempt_id
+    accepted = await _send_main_event(payload)
+    return DeliveryHandoff(attempt_id) if accepted else False
+
