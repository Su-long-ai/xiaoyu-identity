+async def send_report(item: Any) -> Any:
+    """Hand off one durable row; visible effect needs a later receipt."""
+    payload = dict(item.payload or {})
+    if item.kind == "task_result":
+        return await _send_effect_report(item, {"event_type": "task_result", **payload, "timestamp": _now_iso()})
+    text = str(payload.get("text") or "").strip()
