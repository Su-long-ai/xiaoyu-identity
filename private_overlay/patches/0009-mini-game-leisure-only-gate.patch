+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "state",
+    [
+        "focused_work",
+        "focused_video",
+        "gaming",
+        "transitioning",
+        "chatting",
+        "voice_engaged",
+        "stale_returning",
+        "away",
+        "private",
+    ],
+)
+async def test_maybe_deliver_is_leisure_only(monkeypatch, state):
+    """A short input gap must not turn active/ambiguous states into free time."""
+    monkeypatch.setattr(sr, 'MINI_GAME_INVITE_TRIGGER_PROBABILITY', 1.0)
+    out = await sr._maybe_deliver_mini_game_invite(
+        lanlan_name=LANLAN,
+        mgr=_make_mgr(),
+        activity_snapshot=_make_snapshot(state=state, propensity='open'),
+        invite_lang='zh',
+        master_name=MASTER,
+    )
+    assert out is None
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("state", ["casual_browsing", "idle"])
+async def test_maybe_deliver_allows_explicit_leisure_states(monkeypatch, state):
+    monkeypatch.setattr(sr, 'MINI_GAME_INVITE_TRIGGER_PROBABILITY', 1.0)
+    out = await sr._maybe_deliver_mini_game_invite(
+        lanlan_name=LANLAN,
+        mgr=_make_mgr(sid=f"sid-{state}"),
+        activity_snapshot=_make_snapshot(state=state, propensity='open'),
+        invite_lang='zh',
+        master_name=MASTER,
+    )
+    assert out is not None
+    assert out["action"] == "chat"
+
+
 @pytest.mark.asyncio
 async def test_maybe_deliver_returns_none_when_away(monkeypatch):
     """User away: nobody can answer invitations."""
