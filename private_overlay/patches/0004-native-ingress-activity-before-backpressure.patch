diff --git a/main_logic/core/asr_runtime.py b/main_logic/core/asr_runtime.py
index d7a98215..7abb68ba 100644
--- a/main_logic/core/asr_runtime.py
+++ b/main_logic/core/asr_runtime.py
@@ -3677,6 +3677,49 @@ class AsrRuntimeMixin:
             getattr(self, "session", None),
         )
 
+    def _note_native_realtime_ingress_activity(self, message: dict) -> None:
+        """Publish loud native PCM activity before the bounded worker queue.
+
+        The realtime client's turn-admission lock is intentionally shared with
+        proactive callback delivery. While a slow proactive media transaction
+        owns that lock, the audio worker can block on its first frame and the
+        bounded ingress queue continues filling behind it. If user activity is
+        only published inside OmniRealtimeClient.stream_audio(), speech
+        arriving during that backpressure is invisible to the existing
+        proactive user-priority gates until it is too late.
+
+        Mirror the realtime client's raw-RMS threshold here, after the frame
+        has passed ingress validation but before it enters the queue. This is
+        only an arbitration signal: provider audio, VAD state, transcripts,
+        buffer clearing and DSP remain owned by the normal worker path.
+        """
+        if self._asr_route_mode != "native":
+            return
+        session = getattr(self, "session", None)
+        if not isinstance(session, _core_facade.OmniRealtimeClient):
+            return
+        data = message.get("data")
+        if not isinstance(data, list) or not data:
+            return
+        try:
+            threshold = float(
+                getattr(session, "_client_vad_threshold", 500.0)
+            )
+            mean_square = sum(
+                float(sample) * float(sample) for sample in data
+            ) / len(data)
+            rms = math.sqrt(mean_square)
+        except (TypeError, ValueError, OverflowError, ZeroDivisionError):
+            return
+        if rms <= threshold:
+            return
+        now = time.time()
+        previous = float(
+            getattr(session, "_user_recent_activity_time", 0.0) or 0.0
+        )
+        if now > previous:
+            session._user_recent_activity_time = now
+
     async def _enqueue_audio_stream_data(self, message: dict) -> None:
         self._ensure_asr_runtime_state()
         if self._normal_capture_end_owner is not None:
