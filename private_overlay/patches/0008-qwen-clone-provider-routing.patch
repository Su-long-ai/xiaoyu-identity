+@pytest.mark.unit
+def test_qwen_realtime_tempo_stream_slows_without_pitch_shift():
+    import numpy as np
+    from main_logic.tts_client.workers.qwen_audio import QwenRealtimeTempoStream
+
+    sample_rate = 24000
+    seconds = 1.0
+    t = np.arange(int(sample_rate * seconds), dtype=np.float32) / sample_rate
+    pcm = (0.2 * np.sin(2 * np.pi * 440.0 * t) * 32767.0).astype(np.int16)
+
+    stream = QwenRealtimeTempoStream(0.8, sample_rate=sample_rate)
+    chunks = []
+    raw = pcm.tobytes()
+    bytes_per_chunk = 960 * 2
+    for offset in range(0, len(raw), bytes_per_chunk):
+        chunks.extend(stream.push_pcm16(raw[offset:offset + bytes_per_chunk]))
+    chunks.extend(stream.finish())
+
+    output = np.concatenate(chunks)
+    assert 1.20 < (len(output) / len(pcm)) < 1.30
+    freq = np.fft.rfftfreq(len(output), 1.0 / sample_rate)
+    peak_hz = float(freq[np.argmax(np.abs(np.fft.rfft(output)))])
+    assert 438.0 < peak_hz < 442.0
+
