@@ -0,0 +1,137 @@
+from __future__ import annotations
+
+from unittest.mock import Mock
+
+import pytest
+
+import main_logic.tts_client as tts_client
+from main_logic.core import tts_runtime
+from main_logic.tts_client.workers import qwen_audio
+from utils.tts import provider_registry
+
+
+LOCAL_REF = "xiaoyu-qwen-clone-v1"
+REALTIME_MODEL = "qwen3.8-omni-flash-realtime"
+REALTIME_VOICE = "qwen-omni-vc-xiaoyu38-voice-20261120215205543-0243"
+TTS_MODEL = "qwen-audio-3.1-tts-flash"
+TTS_VOICE = "qwen-audio-3.1-tts-flash-xiaoyu31-d89c2c437bd5456ebaa84dbdd2c40339"
+
+
+def bundle_meta(**overrides):
+    data = {
+        "provider": "qwen_bundle",
+        "provider_label": "Qwen 克隆",
+        "source": "clone",
+        "display_name": "XiaoYu · Qwen 克隆",
+        "tts_model": TTS_MODEL,
+        "tts_voice_id": TTS_VOICE,
+        "tts_base_url": "https://dashscope.aliyuncs.com/api/v1",
+        "realtime_provider": "qwen",
+        "realtime_model": REALTIME_MODEL,
+        "realtime_voice_id": REALTIME_VOICE,
+        "speech_rate": 1.0,
+    }
+    data.update(overrides)
+    return data
+
+
+def make_manager():
+    cm = Mock()
+    cm.get_core_config.return_value = {
+        "coreApi": "qwen",
+        "assistApi": "qwen",
+        "ASSIST_API_KEY_QWEN": "qwen-key",
+    }
+    cm.get_model_api_config.return_value = {"api_key": "qwen-key"}
+    cm.voice_id_exists_in_any_storage.return_value = True
+    return cm
+
+
+def test_bundle_routes_text_tts_to_existing_provider_registry(monkeypatch):
+    cm = make_manager()
+    monkeypatch.setattr(tts_client, "get_config_manager", lambda: cm)
+    monkeypatch.setattr(
+        tts_client,
+        "_get_voice_meta",
+        lambda voice_id: bundle_meta() if voice_id == LOCAL_REF else None,
+    )
+
+    worker, api_key, provider = tts_client.get_tts_worker(
+        "qwen",
+        True,
+        LOCAL_REF,
+    )
+
+    assert provider == "qwen_bundle"
+    assert api_key == "qwen-key"
+    assert worker.func is qwen_audio.qwen_audio_tts_worker
+    assert worker.keywords["model"] == TTS_MODEL
+    assert worker.keywords["remote_voice"] == TTS_VOICE
+    assert worker.keywords["speech_rate"] == 1.0
+
+
+def runtime(monkeypatch, *, meta=None, core_api_type="qwen"):
+    obj = tts_runtime.TtsRuntimeMixin.__new__(tts_runtime.TtsRuntimeMixin)
+    obj.voice_id = LOCAL_REF
+    obj.core_api_type = core_api_type
+    obj._is_free_preset_voice = False
+    obj._config_manager = make_manager()
+    obj._is_livestream_active = lambda: False
+    obj._is_vllm_omni_tts_enabled = lambda _cfg: False
+    monkeypatch.setattr(
+        tts_client,
+        "_get_voice_meta",
+        lambda voice_id: (meta or bundle_meta()) if voice_id == LOCAL_REF else None,
+    )
+    return obj
+
+
+def test_matching_bundle_uses_native_omni_voice(monkeypatch):
+    obj = runtime(monkeypatch)
+    cfg = {"model": REALTIME_MODEL, "base_url": "wss://dashscope.aliyuncs.com/api-ws/v1/realtime"}
+
+    assert obj._resolve_qwen_bundle_realtime_voice(cfg) == REALTIME_VOICE
+    assert obj._resolve_realtime_voice(cfg) == REALTIME_VOICE
+
+
+@pytest.mark.parametrize(
+    "core_api_type,meta,model",
+    [
+        ("openai", bundle_meta(), REALTIME_MODEL),
+        ("qwen", bundle_meta(realtime_provider="qwen_intl"), REALTIME_MODEL),
+        ("qwen", bundle_meta(), "qwen3.7-omni-flash-realtime"),
+        ("qwen", bundle_meta(realtime_voice_id=""), REALTIME_MODEL),
+        ("qwen", {"provider": "cosyvoice"}, REALTIME_MODEL),
+    ],
+)
+def test_bundle_never_leaks_to_wrong_realtime_route(monkeypatch, core_api_type, meta, model):
+    obj = runtime(monkeypatch, meta=meta, core_api_type=core_api_type)
+    assert obj._resolve_qwen_bundle_realtime_voice({"model": model}) is None
+
+
+def test_voice_session_bypasses_external_tts_only_on_exact_match(monkeypatch):
+    obj = runtime(monkeypatch)
+    cfg = {"model": REALTIME_MODEL, "base_url": "wss://dashscope.aliyuncs.com/api-ws/v1/realtime"}
+    monkeypatch.setattr(
+        tts_runtime._core_facade,
+        "selected_configured_tts_preset_provider_key",
+        lambda *_args, **_kwargs: None,
+    )
+
+    assert obj._resolve_session_use_tts("voice", cfg, {}) is False
+    assert obj._resolve_session_use_tts("text", cfg, {}) is True
+
+
+def test_qwen_bundle_provider_is_clone_only_hidden_config():
