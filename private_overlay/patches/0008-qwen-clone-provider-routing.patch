diff --git a/main_logic/tts_client/workers/qwen_audio.py b/main_logic/tts_client/workers/qwen_audio.py
new file mode 100644
index 00000000..8ea403bf
--- /dev/null
+++ b/main_logic/tts_client/workers/qwen_audio.py
@@ -0,0 +1,294 @@
+# Copyright 2025-2026 Project N.E.K.O. Team
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+"""Qwen-Audio TTS worker for saved XiaoYu/Qwen voice bundles.
+
+This is intentionally a thin adapter over Alibaba Cloud Model Studio's public
+Qwen-Audio-TTS HTTP API.  Voice creation/management remains external; N.E.K.O
+only synthesizes text with the already-created remote voice ID.
+"""
+
+from __future__ import annotations
+
+import io
+import wave
+from functools import partial
+from urllib.parse import urlparse
+
+import numpy as np
+import soxr
+
+from utils.logger_config import get_module_logger
+
+from .._infra import _enqueue_error, _resample_audio, _run_sentence_tts_worker
+from .._telemetry import _record_tts_telemetry
+from .dummy import dummy_tts_worker
+
+logger = get_module_logger(__name__, "Main")
+
+QWEN_AUDIO_TTS_DEFAULT_BASE_URL = "https://dashscope.aliyuncs.com/api/v1"
+QWEN_AUDIO_TTS_DEFAULT_MODEL = "qwen-audio-3.1-tts-flash"
+
+
+class QwenRealtimeTempoStream:
+    """Pitch-preserving streaming tempo adjustment for Qwen Realtime PCM16.
+
+    Alibaba's Qwen-Omni-Realtime session schema exposes voice selection but no
+    speech-speed field.  Reuse N.E.K.O's pinned audiolab/FFmpeg dependency
+    instead of implementing a private time-stretch algorithm.
+    """
+
+    def __init__(self, speech_rate: float = 1.0, *, sample_rate: int = 24000):
+        try:
+            rate = float(speech_rate)
+        except (TypeError, ValueError):
+            rate = 1.0
+        self.speech_rate = max(0.5, min(2.0, rate))
+        self.sample_rate = int(sample_rate)
+        self._pipe = None
+        self._started = False
+        if abs(self.speech_rate - 1.0) > 1e-6:
+            from audiolab.av import filter as audio_filter
+            from audiolab.pipe import AudioPipe
+
+            self._pipe = AudioPipe(
+                in_rate=self.sample_rate,
+                filters=[audio_filter.atempo(self.speech_rate)],
+                dtype=np.float32,
+                frame_size=1024,
+                always_2d=True,
+            )
+
+    @staticmethod
+    def _pcm16_to_float(audio_data: bytes) -> np.ndarray:
+        audio = np.frombuffer(audio_data or b"", dtype=np.int16)
+        return audio.astype(np.float32) / 32768.0
+
+    def push_pcm16(self, audio_data: bytes) -> list[np.ndarray]:
+        audio_float = self._pcm16_to_float(audio_data)
+        if audio_float.size == 0:
+            return []
+        if self._pipe is None:
+            return [audio_float]
+
+        self._pipe.push(audio_float[None, :])
+        self._started = True
+        return [
+            frame.reshape(-1).astype(np.float32, copy=False)
+            for frame, _rate in self._pipe.pull()
+        ]
+
+    def finish(self) -> list[np.ndarray]:
+        if self._pipe is None or not self._started:
+            return []
+        chunks = [
+            frame.reshape(-1).astype(np.float32, copy=False)
+            for frame, _rate in self._pipe.pull(partial=True)
+        ]
+        self._started = False
+        return chunks
+
+
+def _qwen_audio_http_url(base_url: str | None) -> str:
+    base = str(base_url or QWEN_AUDIO_TTS_DEFAULT_BASE_URL).strip().rstrip("/")
+    suffix = "/services/audio/tts/SpeechSynthesizer"
+    if base.endswith(suffix):
+        return base
+    return base + suffix
+
+
+def _decode_qwen_audio_wav(audio_bytes: bytes) -> tuple[np.ndarray, int]:
+    if audio_bytes[:4] != b"RIFF":
+        raise RuntimeError("Qwen-Audio TTS did not return a WAV payload")
+    with wave.open(io.BytesIO(audio_bytes), "rb") as wav:
+        sample_rate = wav.getframerate()
+        channels = wav.getnchannels()
+        sample_width = wav.getsampwidth()
+        frames = wav.readframes(wav.getnframes())
+    if sample_width != 2:
+        raise RuntimeError(f"Qwen-Audio TTS returned unsupported WAV depth: {sample_width * 8}bit")
+    audio = np.frombuffer(frames, dtype=np.int16)
+    if channels > 1:
+        audio = audio.reshape(-1, channels).astype(np.int32).mean(axis=1)
+        audio = np.round(audio).astype(np.int16)
+    return audio, sample_rate
+
+
+async def synthesize_qwen_audio_bytes(
+    api_key: str,
+    text: str,
+    *,
+    base_url: str | None = None,
+    model: str = QWEN_AUDIO_TTS_DEFAULT_MODEL,
+    remote_voice: str,
+    speech_rate: float = 1.0,
+    client=None,
+) -> bytes:
+    """Synthesize one utterance through Qwen-Audio and return WAV bytes."""
+    import httpx
+
+    api_url = _qwen_audio_http_url(base_url)
+    effective_model = str(model or QWEN_AUDIO_TTS_DEFAULT_MODEL).strip()
+    effective_voice = str(remote_voice or "").strip()
+    if not api_key:
+        raise RuntimeError("Qwen-Audio TTS API key is not configured")
+    if not effective_voice:
+        raise RuntimeError("Qwen-Audio clone voice is not configured")
+    try:
+        rate = float(speech_rate)
+    except (TypeError, ValueError):
+        rate = 1.0
+    rate = max(0.5, min(2.0, rate))
+
+    owns_client = client is None
+    if client is None:
+        client = httpx.AsyncClient(
+            timeout=httpx.Timeout(connect=10, read=60, write=15, pool=10),
+            limits=httpx.Limits(max_connections=4, max_keepalive_connections=2),
+            trust_env=False,
+        )
+    try:
+        response = await client.post(
+            api_url,
+            headers={
+                "Authorization": f"Bearer {api_key}",
+                "Content-Type": "application/json",
+            },
+            json={
+                "model": effective_model,
+                "input": {
+                    "text": text,
+                    "voice": effective_voice,
+                    "format": "wav",
+                    "sample_rate": 24000,
+                    "rate": rate,
+                },
+            },
+        )
+        if response.status_code != 200:
+            raise RuntimeError(f"Qwen-Audio TTS HTTP {response.status_code}: {response.text[:300]}")
+        body = response.json()
+        output = body.get("output") if isinstance(body, dict) else None
+        audio_meta = output.get("audio") if isinstance(output, dict) else None
+        audio_url = audio_meta.get("url") if isinstance(audio_meta, dict) else None
+        if not isinstance(audio_url, str) or not audio_url.startswith(("http://", "https://")):
+            raise RuntimeError("Qwen-Audio TTS response did not contain an audio URL")
+        audio_response = await client.get(audio_url)
+        if audio_response.status_code != 200:
+            raise RuntimeError(f"Qwen-Audio audio download HTTP {audio_response.status_code}")
+        audio_bytes = bytes(audio_response.content)
+        _decode_qwen_audio_wav(audio_bytes)
+        return audio_bytes
+    finally:
+        if owns_client:
+            await client.aclose()
+
+
+def qwen_audio_tts_worker(
+    request_queue,
+    response_queue,
+    audio_api_key,
+    voice_id,
+    *,
+    base_url: str | None = None,
+    model: str = QWEN_AUDIO_TTS_DEFAULT_MODEL,
+    remote_voice: str = "",
+    speech_rate: float = 1.0,
+):
+    import httpx
+
+    effective_model = str(model or QWEN_AUDIO_TTS_DEFAULT_MODEL).strip()
+    effective_voice = str(remote_voice or "").strip()
+    try:
+        rate = float(speech_rate)
+    except (TypeError, ValueError):
+        rate = 1.0
+    rate = max(0.5, min(2.0, rate))
+
+    async def setup(response_queue):
+        if not audio_api_key:
+            _enqueue_error(response_queue, {
+                "code": "QWEN_AUDIO_TTS_API_KEY_MISSING",
+                "provider": "qwen_bundle",
+                "message": "Qwen-Audio TTS API key is not configured",
+            })
+            raise RuntimeError("Qwen-Audio TTS API key is not configured")
+        if not effective_voice:
+            _enqueue_error(response_queue, {
+                "code": "QWEN_AUDIO_TTS_VOICE_MISSING",
+                "provider": "qwen_bundle",
+                "message": "Qwen-Audio clone voice is not configured",
+            })
+            raise RuntimeError("Qwen-Audio clone voice is not configured")
+
+        client = httpx.AsyncClient(
+            timeout=httpx.Timeout(connect=10, read=60, write=15, pool=10),
+            limits=httpx.Limits(max_connections=4, max_keepalive_connections=2),
+            trust_env=False,
+        )
+
+        async def synthesize(text: str, speech_id: str) -> None:
+            try:
+                audio_bytes = await synthesize_qwen_audio_bytes(
+                    audio_api_key,
+                    text,
+                    base_url=base_url,
+                    model=effective_model,
+                    remote_voice=effective_voice,
+                    speech_rate=rate,
+                    client=client,
+                )
+                audio, sample_rate = _decode_qwen_audio_wav(audio_bytes)
+                resampler = soxr.ResampleStream(sample_rate, 48000, 1, dtype="float32")
+                response_queue.put(_resample_audio(audio, sample_rate, 48000, resampler, last=True))
+                _record_tts_telemetry(effective_model, len(text))
+            except Exception as exc:
+                logger.warning("Qwen-Audio TTS synthesis failed: %s", type(exc).__name__)
+                _enqueue_error(response_queue, {
+                    "code": "QWEN_AUDIO_TTS_REQUEST_FAILED",
+                    "provider": "qwen_bundle",
+                    "message": type(exc).__name__,
+                })
+
+        return synthesize, client.aclose
+
+    _run_sentence_tts_worker(
+        request_queue,
+        response_queue,
+        setup,
+        label="Qwen-Audio TTS",
+        safe_error_provider="qwen_bundle",
+        # Qwen-Audio chooses a materially faster cadence for short isolated
+        # sentences. Preview synthesizes the full text in one request, so keep
+        # runtime replies whole-turn as well to make the saved speech_rate mean
+        # the same thing in preview and conversation.
+        coalesce_until_flush=True,
+    )
+
+
