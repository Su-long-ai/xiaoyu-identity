+# ============================================================================
+# Qwen-Audio + Qwen3.8 Omni paired voice cloning
+# ============================================================================
+
+QWEN_BUNDLE_DEFAULT_BASE_URL = "https://dashscope.aliyuncs.com/api/v1"
+QWEN_BUNDLE_TTS_MODEL = "qwen-audio-3.1-tts-flash"
+QWEN_BUNDLE_REALTIME_MODEL = "qwen3.8-omni-flash-realtime"
+
+
+class QwenBundleVoiceCloneError(VoiceCloneError):
+    """Qwen-Audio / Qwen-Omni paired voice-clone error."""
+
+
+def _qwen_bundle_prefix(prefix: str) -> str:
+    value = ''.join(ch for ch in str(prefix or '').strip() if ch.isascii() and ch.isalnum())[:10]
+    if not value:
+        raise QwenBundleVoiceCloneError("Qwen 声音复刻前缀只能包含英文字母和数字，长度 1-10")
+    return value
+
+
+def _qwen_bundle_language(ref_language: str) -> str:
+    return {
+        'ch': 'zh', 'zh': 'zh', 'en': 'en', 'fr': 'fr', 'de': 'de',
+        'ja': 'ja', 'ko': 'ko', 'ru': 'ru',
+    }.get(str(ref_language or 'ch').strip().lower(), 'zh')
+
+
+class QwenBundleVoiceCloneClient:
+    """Create a paired Qwen-Audio-TTS + Qwen3.8-Omni clone from one sample.
+
+    Both calls use Alibaba Model Studio's official customization endpoint.
+    The returned remote IDs are stored under one N.E.K.O voice-library entry.
+    """
+
+    def __init__(self, api_key: str, base_url: str = QWEN_BUNDLE_DEFAULT_BASE_URL):
+        self.api_key = str(api_key or '').strip()
+        self.base_url = str(base_url or QWEN_BUNDLE_DEFAULT_BASE_URL).strip().rstrip('/')
+
+    @property
+    def endpoint(self) -> str:
+        return self.base_url + "/services/audio/tts/customization"
+
+    @staticmethod
+    def _data_uri(audio_bytes: bytes, mime_type: str = "audio/wav") -> str:
+        return f"data:{mime_type};base64," + base64.b64encode(audio_bytes).decode("ascii")
+
+    async def _post(self, payload: dict) -> dict:
+        headers = {
+            "Authorization": f"Bearer {self.api_key}",
+            "Content-Type": "application/json",
+        }
+        try:
+            async with httpx.AsyncClient(
+                timeout=httpx.Timeout(connect=10, read=90, write=30, pool=10),
+                trust_env=False,
+            ) as client:
+                response = await client.post(self.endpoint, headers=headers, json=payload)
+        except httpx.TimeoutException as exc:
+            raise QwenBundleVoiceCloneError("Qwen 声音复刻请求超时") from exc
+        except Exception as exc:
+            raise QwenBundleVoiceCloneError(f"Qwen 声音复刻请求失败: {type(exc).__name__}") from exc
+        if response.status_code != 200:
+            detail = response.text[:500]
+            raise QwenBundleVoiceCloneError(
+                f"Qwen 声音复刻 HTTP {response.status_code}: {detail}"
+            )
+        try:
+            data = response.json()
+        except ValueError as exc:
+            raise QwenBundleVoiceCloneError("Qwen 声音复刻返回了无法解析的响应") from exc
+        if not isinstance(data, dict):
+            raise QwenBundleVoiceCloneError("Qwen 声音复刻返回格式异常")
+        return data
+
+    async def create_tts_voice(
+        self,
+        audio_bytes: bytes,
+        *,
+        prefix: str,
+        ref_language: str = "ch",
+        target_model: str = QWEN_BUNDLE_TTS_MODEL,
+    ) -> str:
+        safe_prefix = _qwen_bundle_prefix(prefix)
+        payload = {
+            "model": "voice-enrollment",
+            "input": {
+                "action": "create_voice",
+                "target_model": target_model,
+                "prefix": safe_prefix,
+                "audio": self._data_uri(audio_bytes),
+                "language_hints": [_qwen_bundle_language(ref_language)],
+                "enable_volume_normalization": "false",
+            },
+        }
+        data = await self._post(payload)
+        voice_id = str(((data.get("output") or {}).get("voice_id") or "")).strip()
+        if not voice_id:
+            raise QwenBundleVoiceCloneError("Qwen-Audio 复刻成功响应中没有 voice_id")
+        return voice_id
+
+    async def create_realtime_voice(
+        self,
+        audio_bytes: bytes,
+        *,
+        prefix: str,
+        target_model: str = QWEN_BUNDLE_REALTIME_MODEL,
+    ) -> str:
+        safe_prefix = _qwen_bundle_prefix(prefix)
+        payload = {
+            "model": "qwen-voice-enrollment",
+            "parameters": {"voice_clone_mode": "normal"},
+            "input": {
+                "action": "create",
+                "target_model": target_model,
+                "preferred_name": safe_prefix,
+                "audio": {"data": self._data_uri(audio_bytes)},
+            },
+        }
+        data = await self._post(payload)
+        voice = str(((data.get("output") or {}).get("voice") or "")).strip()
+        if not voice:
+            raise QwenBundleVoiceCloneError("Qwen3.8 Omni 复刻成功响应中没有 voice")
+        return voice
+
+    async def clone_bundle(
+        self,
+        audio_bytes: bytes,
+        *,
+        prefix: str,
+        ref_language: str = "ch",
+    ) -> tuple[str, str]:
+        # TTS first: it is used by ordinary text replies; Omni is the realtime half.
+        tts_voice = await self.create_tts_voice(
+            audio_bytes,
+            prefix=prefix,
+            ref_language=ref_language,
+        )
+        realtime_voice = await self.create_realtime_voice(
+            audio_bytes,
+            prefix=prefix,
+        )
+        return tts_voice, realtime_voice
+
+
