+@dataclass(frozen=True, slots=True)
+class _NekoClawDeliveryClaim:
+    delivery_id: int
+    attempt_id: str
+    claim_id: str
+    lanlan_name: str | None
+
+
+_nekoclaw_delivery_settlers: set[asyncio.Task] = set()
+
+
+def _spawn_nekoclaw_delivery_settler(coro) -> None:
+    task = asyncio.create_task(coro)
+    _nekoclaw_delivery_settlers.add(task)
+    task.add_done_callback(_nekoclaw_delivery_settlers.discard)
+
+
+async def _claim_nekoclaw_delivery(event: dict) -> _NekoClawDeliveryClaim | bool | None:
+    """Claim a durable NekoClaw row before this process may cross an effect boundary."""
+    raw_delivery_id = event.get("delivery_id")
+    attempt_id = str(event.get("delivery_attempt_id") or "").strip()
+    has_identity = raw_delivery_id is not None or bool(attempt_id)
+    if not has_identity:
+        return None
+    try:
+        if isinstance(raw_delivery_id, bool):
+            raise ValueError("boolean delivery id")
+        delivery_id = int(raw_delivery_id)
+    except (TypeError, ValueError, OverflowError):
+        logger.warning("[EventBus] rejected malformed NekoClaw delivery identity")
+        return False
+    if delivery_id <= 0 or not attempt_id:
+        logger.warning("[EventBus] rejected incomplete NekoClaw delivery identity")
+        return False
+    claim = _NekoClawDeliveryClaim(
+        delivery_id=delivery_id,
+        attempt_id=attempt_id,
+        claim_id=uuid4().hex,
+        lanlan_name=event.get("lanlan_name"),
+    )
+    result = await publish_nekoclaw_delivery_barrier(
+        "claim",
+        claim.delivery_id,
+        claim.attempt_id,
+        claim.claim_id,
+        lanlan_name=claim.lanlan_name,
+    )
+    if result == "claimed":
+        return claim
+    logger.info(
+        "[EventBus] NekoClaw delivery not claimed: id=%s result=%s",
+        claim.delivery_id,
+        result or "no_ack",
+    )
+    return False
+
+
+async def _settle_nekoclaw_delivery(
+    claim: _NekoClawDeliveryClaim,
+    delivered: bool,
+) -> None:
+    action = "commit" if delivered else "release"
+    result = await publish_nekoclaw_delivery_barrier(
+        action,
+        claim.delivery_id,
+        claim.attempt_id,
+        claim.claim_id,
+        lanlan_name=claim.lanlan_name,
+    )
+    accepted = {"committed", "sent"} if delivered else {"released", "sent"}
+    if result not in accepted:
+        # No local retry here. Missing/ambiguous settlement deliberately leaves
+        # the durable host state claimed/uncertain instead of replaying an
+        # effect whose outcome this process cannot prove.
+        logger.warning(
+            "[EventBus] NekoClaw delivery settlement unresolved: id=%s action=%s result=%s",
+            claim.delivery_id,
+            action,
+            result or "no_ack",
+        )
+
+
+async def _settle_nekoclaw_callback_ack(
+    claim: _NekoClawDeliveryClaim,
+    future: asyncio.Future,
+) -> None:
+    try:
+        delivered = bool(await asyncio.shield(future))
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        logger.warning(
+            "[EventBus] NekoClaw native callback receipt failed: id=%s type=%s",
+            claim.delivery_id,
+            type(exc).__name__,
+        )
+        return
+    await _settle_nekoclaw_delivery(claim, delivered)
+
