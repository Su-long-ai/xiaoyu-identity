+_nekoclaw_main_epoch: str | None = None
+_nekoclaw_retired_main_epochs: set[str] = set()
+_nekoclaw_main_epoch_lock = asyncio.Lock()
+
+
+async def _observe_nekoclaw_main_epoch(raw_epoch: Any) -> str:
+    async with _nekoclaw_main_epoch_lock:
+        return await _observe_nekoclaw_main_epoch_locked(raw_epoch)
+
+
+async def _observe_nekoclaw_main_epoch_locked(raw_epoch: Any) -> str:
+    """Freeze old main claims when the native MainServerAgentBridge instance changes."""
+    global _nekoclaw_main_epoch
+    epoch = str(raw_epoch or "").strip()
+    if not epoch:
+        return "missing"
+    if epoch in _nekoclaw_retired_main_epochs:
+        return "stale"
+    previous = _nekoclaw_main_epoch
+    if previous is None:
+        _nekoclaw_main_epoch = epoch
+        return "initialized"
+    if previous == epoch:
+        return "same"
+    host = await ready_host()
+    changed = await host.ledger.outbox_mark_main_restart_uncertain()
+    _nekoclaw_retired_main_epochs.add(previous)
+    _nekoclaw_main_epoch = epoch
+    logger.info(
+        "[NekoClaw] main delivery epoch changed; froze %d claimed result(s)",
+        changed,
+    )
+    return f"reconciled:{changed}"
+
+
+async def _handle_nekoclaw_main_epoch(event: Dict[str, Any]) -> None:
+    event_id = str(event.get("event_id") or "")
+    epoch = str(event.get("main_epoch") or "")
+    result = await _observe_nekoclaw_main_epoch(epoch)
+    if event_id:
+        await _emit_main_event(
+            "nekoclaw_main_epoch_ack",
+            event.get("lanlan_name"),
+            event_id=event_id,
+            main_epoch=epoch,
+            result=result,
+        )
+
+
+async def _handle_nekoclaw_delivery_barrier(event: Dict[str, Any]) -> None:
+    """Persist one exact effect barrier under the same epoch serialization."""
+    event_id = str(event.get("event_id") or "")
+    action = str(event.get("action") or "")
+    attempt_id = str(event.get("delivery_attempt_id") or "")
+    claim_id = str(event.get("delivery_claim_id") or "")
+    raw_delivery_id = event.get("delivery_id")
+    result = "invalid"
+    try:
+        if isinstance(raw_delivery_id, bool):
+            raise ValueError("boolean delivery id")
+        delivery_id = int(raw_delivery_id)
+        if delivery_id <= 0 or not attempt_id or not claim_id:
+            raise ValueError("invalid delivery barrier identity")
+        async with _nekoclaw_main_epoch_lock:
+            epoch_state = await _observe_nekoclaw_main_epoch_locked(
+                event.get("main_epoch")
+            )
+            host = await ready_host()
+            if epoch_state == "stale" and action != "commit":
+                result = "stale_epoch"
+            elif action == "claim":
+                result = await host.ledger.outbox_claim_delivery(
+                    delivery_id, attempt_id, claim_id
+                )
+            elif action == "commit":
+                # A retired process cannot acquire/release effect rights, but
+                # its exact late positive receipt may reconcile the claim that
+                # the restart fence already moved to uncertain.
+                result = await host.ledger.outbox_commit_delivery(
+                    delivery_id, attempt_id, claim_id
+                )
+            elif action == "release":
+                result = await host.ledger.outbox_release_delivery(
+                    delivery_id, attempt_id, claim_id
+                )
+    except Exception as exc:
+        logger.warning("[NekoClaw] delivery barrier failed: action=%s type=%s", action, type(exc).__name__)
+        result = "error"
+    if event_id:
+        await _emit_main_event(
+            "nekoclaw_delivery_barrier_ack",
+            event.get("lanlan_name"),
+            event_id=event_id,
+            action=action,
+            delivery_id=raw_delivery_id,
+            delivery_attempt_id=attempt_id,
+            delivery_claim_id=claim_id,
+            result=result,
+        )
+
