+async def test_handle_text_data_private_quiet_blocks_text_and_paired_tts():
+    """XiaoYu quiet is a whole-reply gate, never an audio-only mute."""
+    mgr = _make_mgr()
+    mgr.current_speech_id = "s_user"
+    mgr._private_speech_fast_override = True
+
+    await LLMSessionManager.handle_text_data(mgr, "must stay silent", is_first_chunk=False)
+
+    mgr.send_lanlan_response.assert_not_called()
+    mgr._enqueue_tts_text_chunk.assert_not_called()
+
+
+async def test_handle_text_data_private_resume_releases_text_and_paired_tts_together():
+    mgr = _make_mgr()
+    mgr.current_speech_id = "s_user"
+    mgr._private_speech_fast_override = False
+
+    await LLMSessionManager.handle_text_data(mgr, "text with voice", is_first_chunk=False)
+
+    mgr.send_lanlan_response.assert_called_once()
+    mgr._enqueue_tts_text_chunk.assert_called_once_with("s_user", "text with voice")
+
+
