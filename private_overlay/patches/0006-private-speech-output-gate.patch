diff --git a/tests/unit/test_private_speech_output_gate.py b/tests/unit/test_private_speech_output_gate.py
new file mode 100644
index 00000000..1e6f307b
--- /dev/null
+++ b/tests/unit/test_private_speech_output_gate.py
@@ -0,0 +1,72 @@
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from main_logic.core.tts_runtime import TtsRuntimeMixin
+
+
+class PrivateSpeechGateTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.state = Path(self.tmp.name) / "state.json"
+        self.obj = TtsRuntimeMixin()
+
+    def _write(self, muted):
+        self.state.write_text(json.dumps({"speech_muted": bool(muted)}), encoding="utf-8")
+
+    def _env(self):
+        return patch.dict(os.environ, {"NEKO_PRIVATE_SPEECH_GATE_FILE": str(self.state)}, clear=False)
+
+    def test_gate_is_disabled_without_env(self):
+        with patch.dict(os.environ, {}, clear=True):
+            self.assertFalse(self.obj._private_speech_output_muted())
+
+    def test_file_gate_tracks_plugin_state(self):
+        self._write(True)
+        with self._env():
+            self.assertTrue(self.obj._private_speech_output_muted())
+            self._write(False)
+            self.assertFalse(self.obj._private_speech_output_muted())
+
+    def test_last_known_gate_survives_atomic_rewrite_gap(self):
+        self._write(True)
+        with self._env():
+            self.assertTrue(self.obj._private_speech_output_muted())
+            self.state.unlink()
+            self.assertTrue(self.obj._private_speech_output_muted())
+
+    def test_fast_exact_mute_closes_current_turn_race(self):
+        self._write(False)
+        with self._env():
+            self.obj._arm_private_speech_fast_control("小鱼，请别说话。")
+            self.assertTrue(self.obj._private_speech_output_muted())
+            self.obj._arm_private_speech_fast_control("朋友让我别说话是什么意思")
+            self.assertFalse(self.obj._private_speech_output_muted())
+
+    def test_fast_unmute_overrides_stale_file_for_current_turn(self):
+        self._write(True)
+        with self._env():
+            self.obj._arm_private_speech_fast_control("可以说话了")
+            self.assertFalse(self.obj._private_speech_output_muted())
+
+    def test_muted_enqueue_never_reaches_tts_worker(self):
+        self._write(True)
+        with self._env():
+            self.obj._enqueue_tts_text_chunk("sid", "这段不能送去TTS")
+
+    async def test_muted_audio_send_is_dropped(self):
+        self._write(True)
+        with self._env():
+            self.assertFalse(await self.obj.send_speech(b"pcm", speech_id="sid"))
+            self.assertEqual(
+                await self.obj.send_cached_speech_batch([b"pcm"], "sid"),
+                (False, False),
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
