+    def _arm_private_speech_fast_control(self, text: str | None) -> None:
+        """Current-turn fast path for explicit XiaoYu speech mute/unmute commands.
+
+        Persistent authority remains the private plugin state file. This only
+        closes the race before the asynchronous semantic classifier updates it.
+        It is disabled completely unless NEKO_PRIVATE_SPEECH_GATE_FILE is set.
+        """
+        if not os.getenv("NEKO_PRIVATE_SPEECH_GATE_FILE", "").strip():
+            self._private_speech_fast_override = None
+            return
+        value = re.sub(r"[\s，。！？、,.!?;；:：~～…]+", "", str(text or "").strip().lower())
+        changed = True
+        while changed:
+            changed = False
+            for prefix in ("小鱼小鱼", "小鱼", "请", "麻烦"):
+                if value.startswith(prefix) and len(value) > len(prefix):
+                    value = value[len(prefix):]
+                    changed = True
+                    break
+        mute = {
+            "不说话", "别说话", "不要说话", "先别说话", "先不要说话",
+            "安静", "安静一下", "先安静", "闭嘴", "别出声", "不要出声",
+        }
+        unmute = {
+            "可以说话了", "可以说了", "你可以说了", "说话吧", "说吧", "你说吧", "那你说吧", "那就说吧",
+            "继续说", "继续说吧", "继续说话", "恢复说话", "解除静音",
+        }
+        if value in mute:
+            self._private_speech_fast_override = True
+        elif value in unmute:
+            self._private_speech_fast_override = False
+        else:
+            self._private_speech_fast_override = None
+
+    def _private_reply_output_blocked(self) -> bool:
+        """Read XiaoYu's optional whole-reply gate.
+
+        The legacy env-var name is kept to avoid a second configuration path.
+        v4 semantics are intentionally one-dimensional: quiet blocks both text
+        and its paired audio before the output path splits. There is no
+        independent "text on, audio off" state.
+        """
+        override = getattr(self, "_private_speech_fast_override", None)
+        if isinstance(override, bool):
+            return override
+
+        path = os.getenv("NEKO_PRIVATE_SPEECH_GATE_FILE", "").strip()
+        if not path:
+            return False
+        cached = getattr(self, "_private_speech_gate_cache", None)
+        try:
+            stat = os.stat(path)
+            key = (path, stat.st_mtime_ns, stat.st_size)
+            if isinstance(cached, tuple) and len(cached) == 2 and cached[0] == key:
+                return bool(cached[1])
+            with open(path, "r", encoding="utf-8") as handle:
+                payload = json.load(handle)
+            blocked = bool(payload.get("quiet", False)) if isinstance(payload, dict) else False
+            self._private_speech_gate_cache = (key, blocked)
+            return blocked
+        except (OSError, ValueError, TypeError):
+            if isinstance(cached, tuple) and len(cached) == 2:
+                key, value = cached
+                if isinstance(key, tuple) and key and key[0] == path:
+                    return bool(value)
+            return False
+
