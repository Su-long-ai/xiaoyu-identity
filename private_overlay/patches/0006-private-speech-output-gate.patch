diff --git a/tests/unit/test_private_speech_output_gate.py b/tests/unit/test_private_speech_output_gate.py
new file mode 100644
index 00000000..0a1f61d4
--- /dev/null
+++ b/tests/unit/test_private_speech_output_gate.py
@@ -0,0 +1,68 @@
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from main_logic.core.tts_runtime import TtsRuntimeMixin
+
+
+class PrivateReplyGateTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.state = Path(self.tmp.name) / "state.json"
+        self.obj = TtsRuntimeMixin()
+
+    def _write(self, quiet, *, speech_muted=False):
+        self.state.write_text(
+            json.dumps({"quiet": bool(quiet), "speech_muted": bool(speech_muted)}),
+            encoding="utf-8",
+        )
+
+    def _env(self):
+        return patch.dict(os.environ, {"NEKO_PRIVATE_SPEECH_GATE_FILE": str(self.state)}, clear=False)
+
+    def test_gate_is_disabled_without_env(self):
+        with patch.dict(os.environ, {}, clear=True):
+            self.assertFalse(self.obj._private_reply_output_blocked())
+
+    def test_file_gate_tracks_quiet_state(self):
+        self._write(True)
+        with self._env():
+            self.assertTrue(self.obj._private_reply_output_blocked())
+            self._write(False)
+            self.assertFalse(self.obj._private_reply_output_blocked())
+
+    def test_legacy_speech_muted_field_cannot_block_reply(self):
+        self._write(False, speech_muted=True)
+        with self._env():
+            self.assertFalse(self.obj._private_reply_output_blocked())
+
+    def test_last_known_gate_survives_atomic_rewrite_gap(self):
+        self._write(True)
+        with self._env():
+            self.assertTrue(self.obj._private_reply_output_blocked())
+            self.state.unlink()
+            self.assertTrue(self.obj._private_reply_output_blocked())
+
+    def test_fast_exact_quiet_closes_current_turn_race(self):
+        self._write(False)
+        with self._env():
+            self.obj._arm_private_speech_fast_control("小鱼，请别说话。")
+            self.assertTrue(self.obj._private_reply_output_blocked())
+            self.obj._arm_private_speech_fast_control("朋友让我别说话是什么意思")
+            self.assertFalse(self.obj._private_reply_output_blocked())
+
+    def test_fast_resume_overrides_stale_file_for_current_turn(self):
+        for phrase in ("可以说话了", "说吧", "你说吧", "那你说吧", "那就说吧", "可以说了"):
+            self._write(True)
+            self.obj._private_speech_fast_override = None
+            with self._env():
+                self.obj._arm_private_speech_fast_control(phrase)
+                self.assertFalse(self.obj._private_reply_output_blocked(), phrase)
+
+
+if __name__ == "__main__":
+    unittest.main()
