@@ -0,0 +1,165 @@
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from main_logic.capability_shadow import (
+    _providers_for_entry,
+    run_plugin_entry_shadows,
+)
+from main_logic.core.proactive import ProactiveMixin
+
+
+class _Catalog:
+    def __init__(self, plugins):
+        self._plugins = plugins
+
+    async def plugins(self):
+        return list(self._plugins)
+
+
+class _Runner:
+    def __init__(self, outcomes):
+        self.outcomes = outcomes
+        self.calls = []
+
+    async def run_entry(self, **kwargs):
+        self.calls.append(kwargs)
+        outcome = self.outcomes[kwargs["plugin_id"]]
+        if isinstance(outcome, Exception):
+            raise outcome
+        if callable(outcome):
+            return await outcome()
+        return outcome
+
+
+def _plugin(plugin_id: str, entry_id: str, *, status: str = "running"):
+    return {
+        "id": plugin_id,
+        "status": status,
+        "entries": [
+            {
+                "id": entry_id,
+                "metadata": {"agent_hidden": True},
+            }
+        ],
+    }
+
+
+def test_hidden_entries_are_discovered_without_agent_visibility():
+    plugins = [
+        _plugin("b_provider", "interruptibility_v1"),
+        _plugin("a_provider", "interruptibility_v1"),
+        _plugin("stopped", "interruptibility_v1", status="stopped"),
+        _plugin("other", "other_entry"),
+    ]
+
+    assert _providers_for_entry(plugins, "interruptibility_v1") == (
+        "a_provider",
+        "b_provider",
+    )
+
+
+@pytest.mark.asyncio
+async def test_shadow_calls_reuse_housekeeping_plugin_runner_path():
+    runner = _Runner(
+        {
+            "candidate": SimpleNamespace(
+                success=True,
+                data={"decision": "abstain", "reason": "evidence_only"},
+                reason="",
+            )
+        }
+    )
+    results = await run_plugin_entry_shadows(
+        "interruptibility_v1",
+        {"activity_state": "gaming"},
+        catalog=_Catalog([_plugin("candidate", "interruptibility_v1")]),
+        runner=runner,
+    )
+
+    assert len(results) == 1
+    assert results[0].provider_id == "candidate"
+    assert results[0].success is True
+    assert results[0].data["decision"] == "abstain"
+    assert runner.calls[0]["housekeeping"] is True
+    assert runner.calls[0]["latest_user_request"] == ""
+    assert runner.calls[0]["args"] == {"activity_state": "gaming"}
+
+
+@pytest.mark.asyncio
+async def test_shadow_timeout_is_observational_not_raised():
+    async def slow():
+        await asyncio.sleep(1.0)
+
+    runner = _Runner({"slow": slow})
+    results = await run_plugin_entry_shadows(
+        "interruptibility_v1",
+        {},
+        timeout_seconds=0.05,
+        catalog=_Catalog([_plugin("slow", "interruptibility_v1")]),
+        runner=runner,
+    )
+
+    assert [(item.provider_id, item.success, item.reason) for item in results] == [
+        ("slow", False, "timeout")
+    ]
+
+
+def test_native_windows_veto_is_unchanged_when_shadow_scheduler_fails(monkeypatch):
+    class Tracker:
+        def get_snapshot_sync(self):
+            return SimpleNamespace(
+                state="idle",
+                os_signals_available=True,
+                user_notification_state=2,
+            )
+
+        def get_user_notification_state_now(self):
+            return 2
+
+    def fail_schedule(*args, **kwargs):
+        raise RuntimeError("plugin server unavailable")
+
+    monkeypatch.setattr(
+        "main_logic.capability_shadow.schedule_plugin_entry_shadow",
+        fail_schedule,
+    )
+    owner = SimpleNamespace(_activity_tracker=Tracker(), lanlan_name="XiaoYu")
+
+    reason = ProactiveMixin._proactive_interruptibility_block_reason(owner)
+
+    assert reason == "windows_notification_state:2"
+
+
+def test_native_activity_veto_is_unchanged_when_shadow_is_only_observing(monkeypatch):
+    observed = []
+
+    class Tracker:
+        def get_snapshot_sync(self):
+            return SimpleNamespace(
+                state="gaming",
+                os_signals_available=True,
+                user_notification_state=5,
+            )
+
+        def get_user_notification_state_now(self):
+            return 5
+
+    monkeypatch.setattr(
+        "main_logic.capability_shadow.schedule_plugin_entry_shadow",
+        lambda entry_id, payload, **kwargs: observed.append(
+            (entry_id, payload, kwargs)
+        )
+        or True,
+    )
+    owner = SimpleNamespace(_activity_tracker=Tracker(), lanlan_name="XiaoYu")
+
+    reason = ProactiveMixin._proactive_interruptibility_block_reason(owner)
+
+    assert reason == "activity_state:gaming"
+    assert observed[0][0] == "interruptibility_v1"
+    assert observed[0][1]["native_block_reason"] == "activity_state:gaming"
+    assert "user_text" not in observed[0][1]
