+    def _proactive_interruptibility_block_reason(
+        self, *, allow_focused_work: bool = False,
+    ) -> str | None:
+        """Return why the latest native activity state vetoes an interruption.
+
+        This is deliberately a final-delivery guard, not another activity
+        detector. It reuses the manager's existing UserActivityTracker so a
+        proactive round cannot rely on a stale snapshot captured several
+        seconds before model generation. Windows' native
+        SHQueryUserNotificationState signal is authoritative whenever local OS
+        signals are available.
+
+        Optional plugin providers are observed only in the background through
+        N.E.K.O's existing PluginCatalog/PluginRunner path. They cannot weaken
+        or delay this native verdict. allow_focused_work exists only for the
+        dedicated work-break reminder; ordinary ambient chatter and
+        entertainment remain blocked while the owner is actively working.
+        """
+        tracker = getattr(self, "_activity_tracker", None)
+        if tracker is None:
+            return None
+        try:
+            snap = tracker.get_snapshot_sync()
+        except Exception as exc:
+            logger.debug(
+                "[%s] proactive interruptibility snapshot unavailable: %s",
+                self.lanlan_name,
+                exc,
+            )
+            return None
+
+        notification_state = getattr(snap, "user_notification_state", None)
+        notification_reader = getattr(tracker, "get_user_notification_state_now", None)
+        if callable(notification_reader):
+            try:
+                live_notification_state = notification_reader()
+            except Exception as exc:
+                logger.debug(
+                    "[%s] live Windows notification-state read failed: %s",
+                    self.lanlan_name,
+                    exc,
+                )
+            else:
+                if isinstance(live_notification_state, int):
+                    notification_state = live_notification_state
+
+        state = getattr(snap, "state", None)
+        reason: str | None = None
+        if (
+            getattr(snap, "os_signals_available", False)
+            and notification_state_blocks_proactive(notification_state)
+        ):
+            reason = f"windows_notification_state:{notification_state}"
+        elif isinstance(state, str):
+            if state in {"idle", "casual_browsing"}:
+                reason = None
+            elif state == "focused_work" and allow_focused_work:
+                reason = None
+            else:
+                reason = f"activity_state:{state}"
+
+        # Shadow providers get only bounded machine-state facts, never user
+        # text, window titles, URLs, screenshots, or memory. Scheduling is a
+        # best-effort observation and cannot alter the synchronous verdict.
+        try:
+            from main_logic.capability_shadow import schedule_plugin_entry_shadow
+
+            schedule_plugin_entry_shadow(
+                "interruptibility_v1",
+                {
+                    "activity_state": state if isinstance(state, str) else "",
+                    "notification_state": (
+                        notification_state if isinstance(notification_state, int) else -1
+                    ),
+                    "os_signals_available": bool(
+                        getattr(snap, "os_signals_available", False)
+                    ),
+                    "allow_focused_work": bool(allow_focused_work),
+                    "native_block_reason": reason or "",
+                },
+                dedupe_key=(
+                    f"{state}:{notification_state}:"
+                    f"{int(bool(allow_focused_work))}:{reason}"
+                ),
+                log_context=str(getattr(self, "lanlan_name", "") or ""),
+            )
+        except Exception as exc:
+            logger.debug(
+                "[%s] interruptibility shadow scheduling skipped: %s",
+                self.lanlan_name,
+                type(exc).__name__,
+            )
+
+        return reason
