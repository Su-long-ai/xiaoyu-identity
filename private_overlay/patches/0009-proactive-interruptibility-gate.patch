new file mode 100644
index 00000000..9280bfa8
--- /dev/null
+++ b/main_logic/capability_shadow.py
@@ -0,0 +1,209 @@
+# Copyright 2025-2026 Project N.E.K.O. Team
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+"""Shadow-only calls to hidden plugin capability entries.
+
+This reuses N.E.K.O's existing PluginCatalog and PluginRunner. It is not a
+second plugin registry or lifecycle manager. The main runtime may ask every
+running plugin that exposes a conventional hidden entry to evaluate the same
+payload in the background. Results are observational only.
+
+The first consumer is interruptibility_v1. Its authoritative native
+Windows/activity veto remains synchronous in ProactiveMixin; a slow, missing,
+or broken plugin can therefore never delay or weaken final delivery.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import time
+import uuid
+from dataclasses import dataclass
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+_DEFAULT_TIMEOUT_SECONDS = 5.0
+_DEFAULT_COOLDOWN_SECONDS = 30.0
+_tasks: set[asyncio.Task[Any]] = set()
+_last_scheduled: dict[tuple[str, str], float] = {}
+_runtime_by_loop: dict[int, tuple[Any, Any]] = {}
+
+
+@dataclass(frozen=True, slots=True)
+class PluginShadowResult:
+    provider_id: str
+    success: bool
+    data: Any = None
+    reason: str = ""
+
+
+def _providers_for_entry(
+    plugins: list[dict[str, Any]], entry_id: str
+) -> tuple[str, ...]:
+    """Return running plugin ids exposing entry_id, including hidden entries."""
+    providers: list[str] = []
+    for plugin in plugins:
+        if not isinstance(plugin, dict) or plugin.get("status") != "running":
+            continue
+        plugin_id = str(plugin.get("id") or "").strip()
+        if not plugin_id:
+            continue
+        entries = plugin.get("entries")
+        if not isinstance(entries, list):
+            continue
+        if any(
+            isinstance(entry, dict) and str(entry.get("id") or "") == entry_id
+            for entry in entries
+        ):
+            providers.append(plugin_id)
+    return tuple(sorted(set(providers)))
+
+
+async def _runtime_for_current_loop() -> tuple[Any, Any]:
+    """Build NekoClaw's existing plugin catalog/runner lazily on this loop."""
+    loop = asyncio.get_running_loop()
+    key = id(loop)
+    existing = _runtime_by_loop.get(key)
+    if existing is not None:
+        return existing
+
+    def load_types():
+        from nekoclaw.host.plugin_runs import PluginCatalog, PluginRunner
+
+        return PluginCatalog, PluginRunner
+
+    PluginCatalog, PluginRunner = await asyncio.to_thread(load_types)
+    catalog = PluginCatalog()
+    runner = PluginRunner(catalog)
+    runtime = (catalog, runner)
+    _runtime_by_loop[key] = runtime
+    return runtime
+
+
+async def run_plugin_entry_shadows(
+    entry_id: str,
+    payload: dict[str, Any],
+    *,
+    timeout_seconds: float = _DEFAULT_TIMEOUT_SECONDS,
+    catalog: Any = None,
+    runner: Any = None,
+) -> tuple[PluginShadowResult, ...]:
+    """Call every running provider of a hidden capability entry.
+
+    housekeeping=True deliberately uses PluginRunner's existing path for
+    host-owned calls so agent_hidden entries remain callable without being
+    offered to NekoClaw's automatic task routing.
+    """
+    if catalog is None or runner is None:
+        catalog, runner = await _runtime_for_current_loop()
+
+    try:
+        plugins = await catalog.plugins()
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        return (
+            PluginShadowResult(
+                provider_id="",
+                success=False,
+                reason=f"catalog:{type(exc).__name__}",
+            ),
+        )
+
+    providers = _providers_for_entry(plugins, entry_id)
+    if not providers:
+        return ()
+
+    async def call(provider_id: str) -> PluginShadowResult:
+        try:
+            outcome = await asyncio.wait_for(
+                runner.run_entry(
+                    commission_id=f"capability-shadow-{uuid.uuid4()}",
+                    plugin_id=provider_id,
+                    entry_id=entry_id,
+                    args=dict(payload),
+                    latest_user_request="",
+                    housekeeping=True,
+                ),
+                timeout=max(0.05, float(timeout_seconds)),
+            )
+        except asyncio.TimeoutError:
+            return PluginShadowResult(provider_id, False, reason="timeout")
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            return PluginShadowResult(
+                provider_id,
+                False,
+                reason=f"{type(exc).__name__}",
+            )
+
+        return PluginShadowResult(
+            provider_id=provider_id,
+            success=bool(getattr(outcome, "success", False)),
+            data=getattr(outcome, "data", None),
+            reason=str(getattr(outcome, "reason", "") or ""),
+        )
+
+    return tuple(await asyncio.gather(*(call(provider) for provider in providers)))
+
+
+def schedule_plugin_entry_shadow(
+    entry_id: str,
+    payload: dict[str, Any],
+    *,
+    dedupe_key: str = "",
+    timeout_seconds: float = _DEFAULT_TIMEOUT_SECONDS,
+    cooldown_seconds: float = _DEFAULT_COOLDOWN_SECONDS,
+    log_context: str = "",
+) -> bool:
+    """Schedule a non-authoritative capability observation without awaiting it."""
+    try:
+        loop = asyncio.get_running_loop()
+    except RuntimeError:
+        return False
+
+    key = (str(entry_id), str(dedupe_key))
+    now = time.monotonic()
+    last = _last_scheduled.get(key)
+    if last is not None and now - last < max(0.0, float(cooldown_seconds)):
+        return False
+    _last_scheduled[key] = now
+
+    async def observe() -> None:
+        results = await run_plugin_entry_shadows(
+            entry_id,
+            dict(payload),
+            timeout_seconds=timeout_seconds,
+        )
+        for result in results:
+            data = result.data if isinstance(result.data, dict) else {}
+            decision = str(data.get("decision") or "unknown")
+            reason = str(data.get("reason") or result.reason or "")
+            logger.info(
+                "capability shadow entry=%s provider=%s context=%s success=%s decision=%s reason=%s",
+                entry_id,
+                result.provider_id or "none",
+                log_context,
+                result.success,
+                decision,
+                reason[:120],
+            )
+
+    task = loop.create_task(observe())
+    _tasks.add(task)
+
+    def done(completed: asyncio.Task[Any]) -> None:
+        _tasks.discard(completed)
+        try:
+            completed.result()
+        except asyncio.CancelledError:
+            pass
+        except Exception:
+            logger.debug("capability shadow task failed", exc_info=True)
+
+    task.add_done_callback(done)
+    return True
