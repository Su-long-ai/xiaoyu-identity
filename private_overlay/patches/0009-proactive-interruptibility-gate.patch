+    mgr.last_user_activity_time = 10.0
+    _set_interruptibility_snapshot(mgr, state="focused_work", notification_state=5)
+    patch_module_clock(monkeypatch, proactive_core, time=lambda: 100.0)
+
+    ambient = await LLMSessionManager.prepare_proactive_delivery(
+        mgr,
+        min_idle_secs=10.0,
+    )
+    assert ambient is False
+
+    # A genuine work-break reminder may interrupt focused_work, but only when
+    # Windows itself says notifications are acceptable.
+    work_break = await LLMSessionManager.prepare_proactive_delivery(
+        mgr,
+        min_idle_secs=10.0,
+        allow_focused_work=True,
+    )
+    assert work_break is True
