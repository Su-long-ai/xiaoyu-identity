new file mode 100644
index 00000000..0590e63b
--- /dev/null
+++ b/tests/unit/test_windows_interruptibility_signal.py
@@ -0,0 +1,93 @@
+from __future__ import annotations
+
+import time
+
+import pytest
+
+from main_logic.activity.state_machine import ActivityStateMachine
+from main_logic.activity.system_signals import (
+    QUNS_ACCEPTS_NOTIFICATIONS,
+    QUNS_APP,
+    QUNS_BUSY,
+    QUNS_NOT_PRESENT,
+    QUNS_PRESENTATION_MODE,
+    QUNS_QUIET_TIME,
+    QUNS_RUNNING_D3D_FULL_SCREEN,
+    SystemSignalCollector,
+    SystemSnapshot,
+    notification_state_blocks_proactive,
+)
+from utils.activity_config import ActivityPreferences
+
+
+def _snapshot(notification_state: int | None, *, os_signals_available: bool = True):
+    sm = ActivityStateMachine(prefs=ActivityPreferences())
+    sm.update_system(
+        SystemSnapshot(
+            timestamp=time.time(),
+            idle_seconds=0.0,
+            cpu_avg_30s=0.0,
+            cpu_instant=0.0,
+            window_title=None,
+            process_name=None,
+            gpu_utilization=None,
+            os_signals_available=os_signals_available,
+            user_notification_state=notification_state,
+        )
+    )
+    return sm.get_snapshot()
+
+
+@pytest.mark.parametrize(
+    "notification_state",
+    [
+        QUNS_NOT_PRESENT,
+        QUNS_BUSY,
+        QUNS_RUNNING_D3D_FULL_SCREEN,
+        QUNS_PRESENTATION_MODE,
+        QUNS_QUIET_TIME,
+    ],
+)
+def test_windows_notification_block_preserves_activity_but_closes_propensity(
+    notification_state: int,
+):
+    snap = _snapshot(notification_state)
+    assert snap.state == "idle"
+    assert snap.propensity == "closed"
+    assert snap.user_notification_state == notification_state
+    assert notification_state_blocks_proactive(notification_state)
+
+
+@pytest.mark.parametrize(
+    "notification_state",
+    [None, QUNS_ACCEPTS_NOTIFICATIONS, QUNS_APP],
+)
+def test_nonblocking_windows_notification_state_keeps_native_propensity(
+    notification_state: int | None,
+):
+    snap = _snapshot(notification_state)
+    assert snap.state == "idle"
+    assert snap.propensity == "open"
+    assert snap.user_notification_state == notification_state
+    assert not notification_state_blocks_proactive(notification_state)
+
+
+def test_remote_or_degraded_os_signal_cannot_veto_local_user():
+    snap = _snapshot(QUNS_BUSY, os_signals_available=False)
+    assert snap.state == "idle"
+    assert snap.propensity == "open"
+
+def test_one_shot_notification_state_reads_windows_authority_when_available():
+    collector = SystemSignalCollector.__new__(SystemSignalCollector)
+    collector._os_signals_available = True
+    collector._read_user_notification_state = lambda: QUNS_BUSY
+    assert collector.user_notification_state_now() == QUNS_BUSY
+
+
+def test_one_shot_notification_state_does_not_read_remote_or_degraded_host():
+    collector = SystemSignalCollector.__new__(SystemSignalCollector)
+    collector._os_signals_available = False
+    called = []
+    collector._read_user_notification_state = lambda: called.append(True)
+    assert collector.user_notification_state_now() is None
+    assert called == []
