+@pytest.mark.asyncio
+async def test_private_provider_native_route_forces_only_first_round():
+    from main_logic.omni_offline_client import OmniOfflineClient
+    from main_logic.tool_calling import ToolCall, ToolDefinition, ToolResult
+    from utils.llm_client import LLMStreamChunk
+
+    tool = ToolDefinition(
+        name="recent_activity",
+        description="recent activity",
+        parameters={"type": "object", "properties": {}},
+    )
+    chunks_call_1 = [
+        LLMStreamChunk(
+            content="",
+            tool_call_deltas=[{
+                "index": 0,
+                "id": "call_recent",
+                "type": "function",
+                "function": {"name": "recent_activity", "arguments": "{}"},
+            }],
+        ),
+        LLMStreamChunk(content="", finish_reason="tool_calls"),
+    ]
+    chunks_call_2 = [LLMStreamChunk(content="你刚才主要在写代码。", finish_reason="stop")]
+    fake_llm = _FakeLLM([chunks_call_1, chunks_call_2])
+
+    client = OmniOfflineClient.__new__(OmniOfflineClient)
+    _init_bare(client)
+    client.llm = fake_llm
+    client._tool_definitions = [tool]
+    client.max_tool_iterations = 3
+    client._use_genai_sdk = False
+    client._genai_tools_unsupported = False
+    client._openai_tools_unsupported = False
+    client._openai_tools_unsupported_with_images = False
+
+    handler_calls = []
+    async def handler(call: ToolCall) -> ToolResult:
+        handler_calls.append(call.name)
+        return ToolResult(call_id=call.call_id, name=call.name, output={"activity": "coding"})
+    client.on_tool_call = handler
+
+    messages = [{"role": "user", "content": "我刚才在电脑上干嘛"}]
+    output = []
+    async for chunk in client._astream_with_tools(
+        messages,
+        _private_forced_tool_route={"name": "recent_activity", "reasoning_effort": "none"},
+    ):
+        output.append(chunk)
+
+    assert handler_calls == ["recent_activity"]
+    assert len(fake_llm.calls) == 2
+    first_overrides = fake_llm.calls[0][1]
+    assert first_overrides["tool_choice"] == {
+        "type": "function",
+        "function": {"name": "recent_activity"},
+    }
+    assert first_overrides["reasoning_effort"] == "none"
+    second_overrides = fake_llm.calls[1][1]
+    assert "tool_choice" not in second_overrides
+    assert "reasoning_effort" not in second_overrides
+    assert "写代码" in "".join(chunk.content for chunk in output)
