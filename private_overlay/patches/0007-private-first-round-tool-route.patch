+def _private_forced_tool_route(text: str, tool_definitions) -> dict | None:
+    """Return one opt-in provider-native first-round tool-choice route."""
+    name = os.getenv(_PRIVATE_FORCED_TOOL_NAME_ENV, "").strip()
+    pattern = os.getenv(_PRIVATE_FORCED_TOOL_PATTERN_ENV, "").strip()
+    if not name or not pattern or not isinstance(text, str) or not text:
+        return None
+    if name not in {str(getattr(tool, "name", "") or "") for tool in (tool_definitions or ())}:
+        return None
+    try:
+        matched = re.search(pattern, text, flags=re.IGNORECASE) is not None
+    except re.error as exc:
+        logger.warning("invalid private forced-tool regex ignored: %s", exc)
+        return None
+    if not matched:
+        return None
+    reasoning_effort = os.getenv(_PRIVATE_FORCED_TOOL_REASONING_ENV, "").strip() or None
+    return {"name": name, "reasoning_effort": reasoning_effort}
+
