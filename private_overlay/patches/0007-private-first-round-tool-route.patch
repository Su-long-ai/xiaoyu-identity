+def test_private_provider_native_route_requires_registered_matching_tool(monkeypatch):
+    from main_logic.omni_offline_client._streaming import _private_forced_tool_route
+    from main_logic.tool_calling import ToolDefinition
+
+    tool = ToolDefinition(name="recent_activity", description="recent activity")
+    monkeypatch.delenv("NEKO_PRIVATE_FORCED_TOOL_NAME", raising=False)
+    monkeypatch.delenv("NEKO_PRIVATE_FORCED_TOOL_PATTERN", raising=False)
+    monkeypatch.delenv("NEKO_PRIVATE_FORCED_TOOL_REASONING_EFFORT", raising=False)
+    assert _private_forced_tool_route("刚才在电脑上干嘛", [tool]) is None
+
+    monkeypatch.setenv("NEKO_PRIVATE_FORCED_TOOL_NAME", "recent_activity")
+    monkeypatch.setenv("NEKO_PRIVATE_FORCED_TOOL_PATTERN", r"刚才.{0,20}电脑")
+    monkeypatch.setenv("NEKO_PRIVATE_FORCED_TOOL_REASONING_EFFORT", "none")
+    assert _private_forced_tool_route("我刚才在电脑上干嘛", [tool]) == {
+        "name": "recent_activity",
+        "reasoning_effort": "none",
+    }
+    assert _private_forced_tool_route("你记得我喜欢哪里吗", [tool]) is None
+
