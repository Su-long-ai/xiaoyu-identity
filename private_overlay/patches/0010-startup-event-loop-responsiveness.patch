+_holiday_ssl_context: ssl.SSLContext | None = None
+_holiday_ssl_context_lock = threading.Lock()
+
+
+def _build_holiday_ssl_context() -> ssl.SSLContext:
+    """Build the shared default SSL context exactly once, off the event loop."""
+    global _holiday_ssl_context
+    if _holiday_ssl_context is not None:
+        return _holiday_ssl_context
+    with _holiday_ssl_context_lock:
+        if _holiday_ssl_context is None:
+            _holiday_ssl_context = ssl.create_default_context()
+        return _holiday_ssl_context
+
+
+async def _get_holiday_ssl_context() -> ssl.SSLContext:
+    if _holiday_ssl_context is not None:
+        return _holiday_ssl_context
+    return await asyncio.to_thread(_build_holiday_ssl_context)
+
