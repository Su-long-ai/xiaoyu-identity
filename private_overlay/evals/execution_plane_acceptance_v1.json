    },
    {
      "id": "recovery.host_restart_active_commission",
      "domain": "recovery",
      "status": "native_gap_probe",
      "severity": "blocker",
      "reason": "Pinned N.E.K.O can resume durable task-agent sessions after runtime-process loss, but Ledger._reconcile still converts prior-host queued/working/waiting_user commissions to failed on host restart. Probe host_restart_continuity_gap freezes this difference; no auto-resume candidate is admitted until interrupted external-call effect safety is classified."
    },
    {
      "id": "recovery.host_restart_report_wait",
      "domain": "recovery",
      "status": "acceptance_gap",
      "severity": "high",
      "reason": "A report-style waiting_user checkpoint is durably resumable by native TaskAgentManager._answer_closed, but pinned Ledger._reconcile still fails it on host restart. Candidate host_restart_report_wait.patch preserves only report questions, keeps permission/tool questions fail-closed, and has product fault-injection coverage; it is not a live managed patch."
    }
